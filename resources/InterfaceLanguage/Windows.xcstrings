    "Reading uses the providers below or the bundled dictionary. Each request shows its destination.": {
      "comment": "Windows reading configuration disclosure; destination admission remains request-owned.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading uses the providers below or the bundled dictionary. Each request shows its destination."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读使用下方的提供方或内置词典。每次请求都会显示其目的地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閱讀使用下方的提供者或內建詞典。每次請求都會顯示其目的地。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リーディングでは以下のプロバイダーまたは内蔵辞書を使用し、各リクエストの送信先を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기는 아래 제공자 또는 내장 사전을 사용하며, 각 요청의 대상을 표시합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture utilise les fournisseurs ci-dessous ou le dictionnaire intégré. Chaque demande affiche sa destination."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesen verwendet die unten gewählten Anbieter oder das integrierte Wörterbuch. Jede Anfrage zeigt ihr Ziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lectura usa los proveedores indicados abajo o el diccionario integrado. Cada solicitud muestra su destino."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A leitura usa os provedores abaixo ou o dicionário integrado. Cada solicitação mostra seu destino."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lettura usa i fornitori indicati sotto o il dizionario integrato. Ogni richiesta mostra la destinazione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтение использует выбранные ниже сервисы или встроенный словарь. Для каждого запроса показывается назначение."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم القراءة الموفّرين أدناه أو القاموس المضمّن. يعرض كل طلب وجهته."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ना नीचे दिए प्रदाताओं या अंतर्निहित शब्दकोश का उपयोग करता है। हर अनुरोध अपना गंतव्य दिखाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembacaan menggunakan penyedia di bawah atau kamus bawaan. Setiap permintaan menampilkan tujuannya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okuma, aşağıdaki sağlayıcıları veya yerleşik sözlüğü kullanır. Her istek hedefini gösterir."
          }
        }
      }
    },
