          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Целью остаётся текущее предложение или выделение. Сокращается только справочный контекст."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedef geçerli cümle veya seçiminizdir. Bütçeye uymak için yalnızca başvuru metni kısaltılır."
