    "Map the selected audio fields or update the Lingrove template.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط حقول الصوت أو حدّث قالب Lingrove."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnen Sie die Audiofelder zu oder aktualisieren Sie die Lingrove-Vorlage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map the selected audio fields or update the Lingrove template."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna los campos de audio o actualiza la plantilla de Lingrove."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez les champs audio ou mettez à jour le modèle Lingrove."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो फ़ील्ड मैप करें या Lingrove टेम्पलेट अपडेट करें।"
          }
        },
        "id": {
