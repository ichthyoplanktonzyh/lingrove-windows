
# Exact upstream overlay/license bytes are verified on both hosts.
# Unified-diff context includes required single-space prefixes.
/patches/*.patch -text whitespace=-blank-at-eol
/native/tts/*.txt text eol=lf
/native/tts/*.cpp text eol=lf
/native/tts/*.h text eol=lf

# Frozen text tables, source digests and accompanying notices are byte-verified.
/src/Cotabby.Core/Resources/Foundation/* text eol=lf
/scripts/capture-editor-foundation-data.swift text eol=lf
/src/Cotabby.Core/Resources/Foundation/CFUniChar.reference.h text eol=lf whitespace=-blank-at-eol,-blank-at-eof

# Preserve the dependency's exact CRLF license bytes, including its final blank line.
/src/Cotabby.Win32/Speech/Notices/LICENSE.NAudio.txt -text whitespace=cr-at-eol,-blank-at-eof
