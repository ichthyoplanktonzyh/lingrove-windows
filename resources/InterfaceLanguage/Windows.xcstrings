    "Browse by meaning\nSelect or create a meaning to compare expressions.": {
      "comment": "Finite Windows authored-copy adapter: Vocabulary.xcstrings / Select a meaning in the sidebar to compare expressions, or create a new meaning. at 3b53402f2cbc196b0398d133177fd80006d165b2.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse by meaning\nSelect or create a meaning to compare expressions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在左侧选择一个语义项以对比不同表达，或新建一个语义项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在左側選擇一個語義項以對比不同表達，或新增一個語義項。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーで意味を選択して表現を比較するか、新しい意味を作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바에서 의미를 선택하여 표현을 비교하거나 새 의미를 만드세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un sens dans la barre latérale pour comparer les expressions, ou créez un nouveau sens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Bedeutung in der Seitenleiste aus, um Ausdrücke zu vergleichen, oder erstelle eine neue Bedeutung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un significado en la barra lateral para comparar expresiones o crea uno nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um significado na barra lateral para comparar expressões ou crie um novo significado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un significato nella barra laterale per confrontare le espressioni oppure creane uno nuovo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите значение на боковой панели, чтобы сравнить выражения, или создайте новое значение."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر معنى من الشريط الجانبي لمقارنة التعبيرات، أو أنشئ معنى جديدًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभिव्यक्तियों की तुलना करने के लिए साइडबार में कोई अर्थ चुनें, या नया अर्थ बनाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih makna di bilah samping untuk membandingkan ungkapan, atau buat makna baru."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İfadeleri karşılaştırmak için kenar çubuğundan bir anlam seçin veya yeni bir anlam oluşturun."
          }
        }
      }
    },
