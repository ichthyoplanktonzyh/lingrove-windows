      }
    },
    "Counts instructions, source, references and output reserve. Saved per model." : {
      "comment" : "Explains the total model budget and its persistence.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشمل التعليمات والمصدر والمراجع واحتياطي المخرجات. يُحفظ لكل نموذج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt Anweisungen, Quelltext, Referenzen und Ausgabereserve. Pro Modell gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
