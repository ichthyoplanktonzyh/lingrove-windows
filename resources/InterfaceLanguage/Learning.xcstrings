          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在確認取代結果前，操作已取消。請複製譯文；如有需要，請還原原文。"
          }
        }
      }
    },
    "The reference voice file is unavailable. Choose a readable WAV or MP3 file." : {
      "localizations" : {
