    "An explanation image is missing. Add it again before sending.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إحدى صور الشرح مفقودة. أضفها مجددًا قبل الإرسال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Erklärungsbild fehlt. Füge es vor dem Senden erneut hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta una imagen de la explicación. Vuelve a añadirla antes de enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image de l’explication manque. Ajoutez-la à nouveau avant l’envoi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्याख्या का चित्र गायब है। भेजने से पहले उसे फिर जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar penjelasan hilang. Tambahkan lagi sebelum mengirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca un’immagine della spiegazione. Aggiungila di nuovo prima dell’invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明の画像が見つかりません。送信前に追加し直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설명 이미지가 없습니다. 다시 추가한 후 보내세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta uma imagem da explicação. Adicione-a novamente antes de enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсутствует изображение пояснения. Добавьте его снова перед отправкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir açıklama görseli eksik. Göndermeden önce yeniden ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解释中的图片缺失，请重新添加后再发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解釋中的圖片遺失，請重新加入後再傳送。"
          }
        }
      }
    },
    "An export image is missing. Restore it or export without images.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إحدى صور التصدير مفقودة. استعدها أو صدّر دون صور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Exportbild fehlt. Stelle es wieder her oder exportiere ohne Bilder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An export image is missing. Restore it or export without images."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta una imagen de exportación. Restáurala o exporta sin imágenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image à exporter est manquante. Restaurez-la ou exportez sans images."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक निर्यात चित्र गायब है। उसे पुनर्स्थापित करें या चित्रों के बिना निर्यात करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar ekspor tidak ditemukan. Pulihkan atau ekspor tanpa gambar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca un’immagine da esportare. Ripristinala o esporta senza immagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出す画像が見つかりません。復元するか、画像なしで書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낼 이미지가 없습니다. 복원하거나 이미지 없이 내보내세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem de exportação está ausente. Restaure-a ou exporte sem imagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображение для экспорта отсутствует. Восстановите его или экспортируйте без изображений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışa aktarılacak bir görsel eksik. Geri yükleyin veya görseller olmadan dışa aktarın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出图片缺失，请恢复图片或关闭附带图片后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出圖片遺失，請還原圖片或關閉附帶圖片後重試。"
          }
        }
      }
    },
