    "Formatted definitions use a private macOS interface and fall back to plain text when unavailable." : {
      "comment" : "Dictionary provider settings or content state.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم التعريفات المنسّقة واجهة macOS خاصة وتعود إلى النص العادي عند تعذرها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formatierte Definitionen nutzen eine private macOS-Schnittstelle und fallen bei Nichtverfügbarkeit auf Klartext zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formatted definitions use a private macOS interface and fall back to plain text when unavailable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las definiciones con formato usan una interfaz privada de macOS; si no está disponible, se muestra texto sin formato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les définitions mises en forme utilisent une interface privée de macOS, avec repli en texte brut si nécessaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वरूपित परिभाषाएँ निजी macOS इंटरफ़ेस का उपयोग करती हैं; अनुपलब्ध होने पर सादा पाठ दिखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definisi berformat memakai antarmuka privat macOS dan beralih ke teks biasa jika tidak tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le definizioni formattate usano un’interfaccia privata di macOS e passano al testo semplice se non disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書式付きの定義には macOS の非公開インターフェースを使用し、利用できない場合はプレーンテキストを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서식이 있는 정의는 macOS 비공개 인터페이스를 사용하며, 사용할 수 없으면 일반 텍스트로 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definições formatadas usam uma interface privada do macOS e voltam ao texto simples quando indisponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Форматированные определения используют закрытый интерфейс macOS; если он недоступен, отображается обычный текст."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
