    "Pause after typing to see a sentence preview." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف قليلًا أثناء الكتابة لترى معاينة ترجمة الجملة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Machen Sie beim Schreiben eine Pause, um die Satzübersetzung zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause after typing to see a sentence preview."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una pausa al escribir para ver la traducción de la frase."
