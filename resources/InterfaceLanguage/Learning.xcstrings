    "Help improve Lingrove by reporting issues or sharing ideas." : {
      "comment" : "Lingrove product identity and language-learning introduction.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساعد في تحسين Lingrove بالإبلاغ عن المشكلات أو مشاركة الأفكار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilf mit, Lingrove zu verbessern: Melde Probleme oder teile Ideen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help improve Lingrove by reporting issues or sharing ideas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuda a mejorar Lingrove informando de problemas o compartiendo ideas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aidez à améliorer Lingrove en signalant des problèmes ou en partageant vos idées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समस्याएँ बताकर या विचार साझा करके Lingrove को बेहतर बनाने में मदद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bantu meningkatkan Lingrove dengan melaporkan masalah atau berbagi ide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiuta a migliorare Lingrove segnalando problemi o condividendo idee."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問題の報告やアイデアの共有で、Lingroveの改善にご協力ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문제를 보고하거나 아이디어를 공유하여 Lingrove 개선에 참여하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajude a melhorar o Lingrove relatando problemas ou compartilhando ideias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помогите улучшить Lingrove: сообщайте о проблемах и делитесь идеями."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorunları bildirerek veya fikirlerinizi paylaşarak Lingrove’u geliştirmeye yardımcı olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反馈问题或分享想法，帮助拾语不断改进。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回報問題或分享想法，幫助拾語持續改進。"
          }
        }
