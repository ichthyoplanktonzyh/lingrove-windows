    "Anki rejected the request. Check the API key, fields and active profile.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض Anki الطلب. تحقق من المفتاح والحقول والملف الشخصي النشط."
          }
        },
        "de": {
          "stringUnit": {
