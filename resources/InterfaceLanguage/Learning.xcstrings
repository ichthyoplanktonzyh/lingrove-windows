    "Choose a trigger that does not start with : or /; those open emoji and macros." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب ألا يبدأ رمز التفعيل بـ : أو /؛ فهما يفتحان الرموز التعبيرية ووحدات الماكرو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Auslöser darf nicht mit : oder / beginnen. Diese öffnen Emojis und Makros."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a trigger that does not start with : or /; those open emoji and macros."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El activador no debe empezar por : ni /; estos abren los emojis y las macros."
          }
        },
        "fr" : {
