    "Existing entries keep their content. New content is added as a separate sense.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing entries keep their content. New content is added as a separate sense."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有词条的内容会保留。新内容将添加为独立义项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "既有詞條的內容會保留。新內容將新增為獨立義項。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存の内容は保持されます。新しい内容は別の語義として追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 내용은 유지됩니다. 새 내용은 별도의 뜻으로 추가됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu existant est conservé. Le nouveau contenu devient une acception distincte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhandene Inhalte bleiben erhalten. Neue Inhalte werden als eigene Bedeutung ergänzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conserva el contenido existente. El nuevo contenido se añade como una acepción independiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo existente é mantido. O novo conteúdo é adicionado como uma acepção separada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto esistente viene conservato. Il nuovo contenuto diventa un’accezione separata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Существующее содержимое сохраняется. Новое добавляется как отдельное значение."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحتفظ بالمحتوى الحالي. يُضاف المحتوى الجديد كدلالة مستقلة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा सामग्री बनी रहेगी। नई सामग्री अलग अर्थ-खंड के रूप में जुड़ेगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi yang ada tetap disimpan. Isi baru ditambahkan sebagai arti terpisah."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut içerik korunur. Yeni içerik ayrı bir anlam olarak eklenir."
          }
        }
      }
    },
    "Only mapped columns are imported. Examples and images are not included.": {
