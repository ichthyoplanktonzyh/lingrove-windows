    "Delete pattern and its restricted associations?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف النمط والارتباطات المقيّدة به؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muster und darauf beschränkte Verknüpfungen löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete pattern and its restricted associations?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar el patrón y sus asociaciones restringidas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette construction et les associations qui s’y limitent ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह प्रयोग-ढाँचा और इससे सीमित संबंध हटाएँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus pola dan hubungan yang terbatas pada pola ini?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare lo schema e le associazioni limitate a esso?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "用法と、その用法に限定された関連付けを削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용법과 해당 용법으로 제한된 연결을 삭제할까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir o padrão e as associações restritas a ele?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить модель и ограниченные ею связи?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalıp ve bu kalıpla sınırlı ilişkiler silinsin mi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除用法及限定于该用法的关联？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除用法及限定於該用法的關聯？"
          }
        }
      }
    },
    "Delete this meaning? Collected expressions will be kept.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف هذا المعنى؟ ستبقى التعبيرات المحفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bedeutung löschen? Gesammelte Ausdrücke bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this meaning? Collected expressions will be kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar este significado? Se conservarán las expresiones guardadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer ce sens ? Les expressions enregistrées seront conservées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अर्थ हटाएँ? सहेजी गई अभिव्यक्तियाँ बनी रहेंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus makna ini? Ungkapan tersimpan tetap dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare questo significato? Le espressioni salvate verranno conservate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この意味を削除しますか？保存した表現は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 의미를 삭제할까요? 저장한 표현은 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir este significado? As expressões salvas serão mantidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить это значение? Сохранённые выражения останутся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anlam silinsin mi? Kaydedilmiş ifadeler korunacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此语义项？生词本中的词条仍会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除此語義項？生詞本中的詞條仍會保留。"
          }
        }
      }
    },
