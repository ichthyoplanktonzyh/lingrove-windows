    "No suggestions yet. Type somewhere to see how long they take.": {
      "comment": "Windows authored interface state/instruction. Template arguments preserve exact values.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No suggestions yet. Type somewhere to see how long they take."
          }
        },
        "zh-Hans": {
