            "value" : "LM Studio 라이브러리(~/.lmstudio/models)의 모델을 위 목록에 추가합니다. 다운로드는 여전히 Lingrove 전용 폴더에 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione modelos da sua biblioteca do LM Studio (~/.lmstudio/models) ao seletor acima. Os downloads continuam sendo salvos na pasta própria do Lingrove."
          }
        },
        "ru" : {
