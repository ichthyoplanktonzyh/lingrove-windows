    "Turn Lingrove off everywhere without quitting the app." : {
      "comment" : "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف Lingrove في كل مكان من دون إنهاء التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingrove überall ausschalten, ohne die App zu beenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva Lingrove en todas partes sin salir de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver Lingrove partout sans quitter l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप बंद किए बिना हर जगह Lingrove बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matikan Lingrove di mana saja tanpa keluar dari app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva Lingrove ovunque senza uscire dall'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを終了せずに、Lingroveをどこでもオフにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 종료하지 않고 어디서나 Lingrove 끄기."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative o Lingrove em todos os lugares sem encerrar o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключать Lingrove везде, не завершая работу приложения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamadan çıkmadan Lingrove'yi her yerde kapatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需退出应用，即可在所有 App 中关闭拾语。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不結束 App 即可在所有地方關閉拾語。"
          }
        }
      }
    },
    "Turn Lingrove on or off everywhere without quitting." : {
