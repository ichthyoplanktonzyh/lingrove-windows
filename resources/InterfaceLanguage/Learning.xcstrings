    "Speech generation failed. Check the model or connection and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل توليد الصوت. تحقق من النموذج أو الاتصال وحاول مجدداً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spracherzeugung ist fehlgeschlagen. Prüfe Modell oder Verbindung und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech generation failed. Check the model or connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo generar la voz. Revisa el modelo o la conexión e inténtalo de nuevo."
