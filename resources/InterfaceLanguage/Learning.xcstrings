    "Bounds the input Lingrove sends, not server capacity. Token counts are estimates with a safety margin." : {
      "comment" : "Endpoint budget and approximate token accounting disclosure.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحد مدخلات Lingrove المرسلة لا سعة الخادم. أعداد الرموز تقديرية بهامش أمان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenzt Lingroves Eingabe, nicht die Serverkapazität. Tokenzahlen sind Schätzungen mit Sicherheitsreserve."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bounds the input Lingrove sends, not server capacity. Token counts are estimates with a safety margin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita lo que envía Lingrove, no la capacidad del servidor. Los tokens se estiman con margen de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite l’entrée envoyée par Lingrove, pas la capacité du serveur. Les tokens sont estimés avec une marge."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingrove का भेजा इनपुट सीमित करता है, सर्वर की क्षमता नहीं। टोकन गिनती सुरक्षा अंतर सहित अनुमान है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membatasi masukan yang dikirim Lingrove, bukan kapasitas server. Jumlah token diperkirakan dengan margin aman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita l’input inviato da Lingrove, non la capacità del server. I token sono stimati con un margine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの容量ではなく、Lingrove が送る入力を制限します。トークン数は余裕を含む推定値です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버 용량이 아닌 Lingrove의 전송 입력을 제한합니다. 토큰 수는 안전 여유를 둔 추정치입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita a entrada enviada pelo Lingrove, não a capacidade do servidor. Tokens são estimados com margem de segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничивает ввод Lingrove, а не ёмкость сервера. Число токенов оценивается с запасом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu kapasitesini değil, Lingrove’un gönderdiği girdiyi sınırlar. Token sayısı güvenlik payıyla tahmin edilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制拾语发送的输入，不改变服务端容量。token 数为带安全余量的估算值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制拾語傳送的輸入，不改變伺服器容量。token 數為含安全餘量的估算值。"
          }
        }
      }
    },
