    "After you finish a word, shows a green replacement you can apply with your accept key." : {
      "comment" : "Fork-owned display copy; the upstream common-table translation contains the previous product brand.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد إكمال كلمة، يعرض استبدالًا أخضر يمكنك تطبيقه بمفتاح القبول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Abschluss eines Wortes wird eine grüne Ersetzung angezeigt, die du mit deiner Übernahmetaste anwenden kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After you finish a word, shows a green replacement you can apply with your accept key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de terminar una palabra, muestra un reemplazo verde que puedes aplicar con la tecla de aceptación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la fin d’un mot, affiche un remplacement vert que vous pouvez appliquer avec votre touche d’acceptation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्द पूरा करने के बाद हरा प्रतिस्थापन दिखाता है, जिसे आप अपनी स्वीकार कुंजी से लागू कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah Anda menyelesaikan kata, Lingrove menampilkan penggantian berwarna hijau yang dapat diterapkan dengan tombol penerimaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver completato una parola, mostra una sostituzione verde che puoi applicare con il tasto di accettazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語を入力し終えると、候補挿入キーで適用できる緑色の置換候補を表示します。"
          }
