    "How many words Lingrove aims for per suggestion." : {
      "comment" : "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد الكلمات التي يستهدفها Lingrove في كل اقتراح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Wörter Lingrove pro Vorschlag anstrebt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántas palabras intenta incluir Lingrove en cada sugerencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de mots visé par Lingrove pour chaque suggestion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingrove प्रति सुझाव कितने शब्दों का लक्ष्य रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah kata yang ditargetkan Lingrove per saran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quante parole Lingrove mira a generare per suggerimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingroveが候補ごとに目指す単語数。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingrove가 제안마다 목표로 하는 단어 수."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantas palavras o Lingrove busca por sugestão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько слов Lingrove старается добавить в одну подсказку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingrove'nin öneri başına hedeflediği kelime sayısı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拾语每条建议目标生成的词数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拾語每次建議預計產生的單字數。"
          }
        }
      }
    },
    "How many words Lingrove aims for per suggestion. Shorter is snappier; longer covers more thoughts but takes longer to generate." : {
      "comment" : "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد الكلمات التي يستهدفها Lingrove في كل اقتراح. الأقصر أسرع استجابة؛ والأطول يغطي أفكارًا أكثر لكنه يستغرق وقتًا أطول للتوليد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Wörter Lingrove pro Vorschlag anstrebt. Kürzer reagiert schneller; länger deckt mehr Gedanken ab, braucht aber länger für die Generierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántas palabras intenta incluir Lingrove en cada sugerencia. Las sugerencias cortas son más ágiles; las largas abarcan más ideas, pero tardan más en generarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de mots visé par Lingrove pour chaque suggestion. Les suggestions plus courtes sont plus rapides ; les plus longues couvrent davantage d’idées, mais prennent plus de temps à générer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingrove प्रति सुझाव कितने शब्दों का लक्ष्य रखता है। छोटे सुझाव अधिक फुर्तीले होते हैं; लंबे सुझाव अधिक विचार समेटते हैं, लेकिन जनरेट होने में अधिक समय लेते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah kata yang ditargetkan Lingrove per saran. Lebih pendek terasa cepat; lebih panjang mencakup lebih banyak gagasan tetapi lebih lama dibuat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quante parole Lingrove mira a generare per ogni suggerimento. I suggerimenti più brevi sono più rapidi; quelli più lunghi sviluppano più idee, ma richiedono più tempo per essere generati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingroveが候補ごとに目指す単語数。短いほど軽快ですが、長いほど多くの考えを含められる一方、生成に時間がかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingrove가 제안마다 목표로 하는 단어 수입니다. 짧을수록 빠르고, 길수록 더 많은 생각을 담지만 생성에 더 오래 걸립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantas palavras o Lingrove busca por sugestão. Sugestões mais curtas são mais ágeis; as mais longas abrangem mais ideias, mas demoram mais para gerar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько слов Lingrove старается добавить в одну подсказку. Короткие подсказки быстрее; длинные охватывают больше мыслей, но создаются дольше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingrove'nin öneri başına hedeflediği kelime sayısı. Daha kısa olan daha çeviktir; daha uzun olan daha fazla düşünceyi kapsar ama oluşturulması daha uzun sürer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拾语每条建议目标生成的词数。较短更利落；较长能覆盖更多想法，但生成时间更久。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拾語每次建議預計產生的單字數。較短的建議更俐落；較長的建議可涵蓋更多想法，但生成時間較久。"
          }
        }
      }
    },
