          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI 兼容服务器地址。如果地址没有路径，拾语会添加 /v1；Ollama 默认使用 http://127.0.0.1:11434。"
          }
