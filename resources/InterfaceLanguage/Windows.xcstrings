    "The model could not be downloaded or verified. Retry after checking the connection and free disk space.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model could not be downloaded or verified. Retry after checking the connection and free disk space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法下载或验证模型，请检查网络连接和可用磁盘空间后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法下載或驗證模型，請檢查網路連線及可用磁碟空間後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルをダウンロードまたは検証できませんでした。接続と空き容量を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 다운로드하거나 검증하지 못했습니다. 연결과 디스크 여유 공간을 확인한 후 다시 시도하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de télécharger ou de vérifier le modèle. Vérifiez la connexion et l’espace disque libre avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell konnte nicht heruntergeladen oder geprüft werden. Prüfen Sie Verbindung und freien Speicherplatz und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar o verificar el modelo. Revisa la conexión y el espacio libre antes de reintentar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível baixar ou verificar o modelo. Confira a conexão e o espaço livre em disco antes de tentar novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare o verificare il modello. Controlla la connessione e lo spazio libero su disco prima di riprovare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось скачать или проверить модель. Проверьте подключение и свободное место и повторите попытку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تنزيل النموذج أو التحقق منه. تحقق من الاتصال والمساحة الحرة على القرص ثم أعد المحاولة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल डाउनलोड या सत्यापित नहीं हुआ। कनेक्शन और खाली डिस्क स्थान जाँचकर फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model tidak dapat diunduh atau diverifikasi. Periksa koneksi dan ruang disk kosong lalu coba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model indirilemedi veya doğrulanamadı. Bağlantıyı ve boş disk alanını kontrol edip yeniden deneyin."
          }
        }
      }
    },
