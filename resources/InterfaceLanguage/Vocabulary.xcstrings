    "Select a semantic domain or meaning group to explore expressions by their role.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a semantic domain or meaning group to explore expressions by their role."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择语义分类或语义项，按语义作用浏览和对比相关表达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇語義分類或語義項，按語義作用瀏覽和對比相關表達。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意味領域または意味グループを選択して、役割に応じた表現を探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의미 영역이나 의미 그룹을 선택하여 역할에 따른 표현을 찾아보세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un domaine sémantique ou un groupe de sens pour explorer les expressions selon leur rôle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Bedeutungsbereich oder eine Bedeutungsgruppe, um Ausdrücke nach ihrer Rolle zu erkunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un dominio semántico o un grupo de significado para explorar expresiones según su función."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um domínio semântico ou grupo de significado para explorar expressões por sua função."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un dominio semantico o un gruppo di significato per esplorare le espressioni in base al loro ruolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите семантическую область или группу значений, чтобы найти выражения по их роли."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجالًا دلاليًا أو مجموعة معانٍ لاستكشاف التعبيرات بحسب دورها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भूमिका के अनुसार भाव खोजने के लिए अर्थ क्षेत्र या अर्थ समूह चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih ranah semantik atau kelompok makna untuk menjelajahi ungkapan berdasarkan perannya."
