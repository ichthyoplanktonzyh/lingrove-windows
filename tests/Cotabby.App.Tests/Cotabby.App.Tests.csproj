<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile the actual non-WPF app boundaries for portable lifetime/settings tests. This is
         no replacement for compiling the complete WPF app or exercising a Windows desktop. -->
    <Compile Include="..\..\src\Cotabby.App\Settings\AppSettings.cs" Link="Production\AppSettings.cs" />
    <Compile Include="..\..\src\Cotabby.App\Settings\AppSettings.Explanation.cs" Link="Production\AppSettings.Explanation.cs" />
    <Compile Include="..\..\src\Cotabby.App\Learning\LearningExplanationController.cs" Link="Production\LearningExplanationController.cs" />
    <Compile Include="..\..\src\Cotabby.App\Learning\LearningTextCopyController.cs" Link="Production\LearningTextCopyController.cs" />
    <Compile Include="..\..\src\Cotabby.App\Learning\LearningExplanationCardPolicy.cs" Link="Production\LearningExplanationCardPolicy.cs" />
    <Compile Include="..\..\src\Cotabby.App\Learning\LearningDictionaryCardPolicy.cs" Link="Production\LearningDictionaryCardPolicy.cs" />
    <ProjectReference Include="..\..\src\Cotabby.Core\Cotabby.Core.csproj" />
    <ProjectReference Include="..\..\src\Cotabby.Inference\Cotabby.Inference.csproj" />
  </ItemGroup>
</Project>
