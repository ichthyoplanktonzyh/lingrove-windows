          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した語義を選びカードを追加します。既存のカードも更新できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장한 뜻을 선택해 카드를 추가합니다. 기존 카드도 업데이트할 수 있습니다."
