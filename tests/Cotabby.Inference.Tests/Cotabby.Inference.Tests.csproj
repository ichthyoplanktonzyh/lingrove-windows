<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\Shared\VocabularyDibFixture.cs" Link="Shared\VocabularyDibFixture.cs" />
    <Compile Include="..\Shared\LearningLexicalCorpus.cs" Link="Shared\LearningLexicalCorpus.cs" />
    <Compile Include="..\Shared\LearningExplanationCaptureCorpus.cs" Link="Shared\LearningExplanationCaptureCorpus.cs" />
    <None Include="..\..\fixtures\parity\learning-explanation-capture-v1.json" Link="fixtures\parity\learning-explanation-capture-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\parity\learning-lexical-v1.json" Link="fixtures\parity\learning-lexical-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\resources\LearningLexicon\learning-expressions*"
          Link="Resources\LearningLexicon\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exercise the real persisted settings without starting the WPF application or touching
         the user's settings directory. This file depends only on Core and Inference contracts. -->
    <Compile Include="..\..\src\Cotabby.App\Settings\AppSettings.cs" Link="AppSettings\AppSettings.cs" />
    <Compile Include="..\..\src\Cotabby.App\Settings\AppSettings.Explanation.cs" Link="AppSettings\AppSettings.Explanation.cs" />
    <Compile Include="..\..\src\Cotabby.App\Learning\LearningModelCatalogManager.cs" Link="AppLearning\LearningModelCatalogManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cotabby.Core\Cotabby.Core.csproj" />
    <ProjectReference Include="..\..\src\Cotabby.Inference\Cotabby.Inference.csproj" />
    <ProjectReference Include="..\..\src\Cotabby.Win32\Cotabby.Win32.csproj" />
  </ItemGroup>

</Project>
