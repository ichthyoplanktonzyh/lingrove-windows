        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समीक्षा ऑडियो के लिए वाणी उपलब्ध नहीं है। ऑडियो तैयार करने से पहले वाणी सेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
