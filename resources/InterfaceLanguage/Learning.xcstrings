        }
      }
    },
    "The color of the inline suggestion. Automatic adapts to light and dark; White suits dark editors." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لون الاقتراح المضمّن. يتكيف التلقائي مع الوضعين الفاتح والداكن؛ ويناسب الأبيض المحررات الداكنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbe des Inline-Vorschlags. Automatisch passt sich an helle und dunkle Darstellung an; Weiß eignet sich für dunkle Editoren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The color of the inline suggestion. Automatic adapts to light and dark; White suits dark editors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color de la sugerencia en línea. Automático se adapta a los modos claro y oscuro; Blanco es adecuado para editores oscuros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleur de la suggestion intégrée. Automatique suit le mode clair ou sombre ; Blanc convient aux éditeurs sombres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनलाइन सुझाव का रंग। स्वचालित हल्के और गहरे रंगरूप के अनुसार बदलता है; सफ़ेद गहरे एडिटर के लिए उपयुक्त है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna saran sebaris. Otomatis menyesuaikan tema terang dan gelap; Putih cocok untuk editor gelap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore del suggerimento in linea. Automatico si adatta al tema chiaro o scuro; Bianco è adatto agli editor scuri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インライン候補の色です。「自動」は明暗に適応し、「白」は暗いエディタに適しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인라인 제안의 색상입니다. 자동은 밝고 어두운 화면에 맞추며 흰색은 어두운 편집기에 적합합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor da sugestão em linha. Automático se adapta aos modos claro e escuro; Branco é adequado a editores escuros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвет встроенной подсказки. Автоматический учитывает светлую и тёмную тему; белый подходит для тёмных редакторов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satır içi önerinin rengi. Otomatik, açık ve koyu görünüme uyum sağlar; Beyaz koyu editörlere uygundur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行内建议的颜色。“自动”适应明暗外观；“白色”适用于深色编辑器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行內建議的顏色。「自動」會適應明暗外觀；「白色」適用於深色編輯器。"
          }
        }
      }
    },
