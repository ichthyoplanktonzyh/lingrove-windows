            "value": "La voz para repaso no está disponible. Configúrala antes de preparar audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz para revisão está indisponível. Configure a voz antes de preparar o áudio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voce per il ripasso non disponibile. Configurala prima di preparare l’audio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Речь для повторения недоступна. Настройте её перед подготовкой аудио."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة النطق للمراجعة غير متاحة. اضبط النطق قبل إعداد الصوت."
