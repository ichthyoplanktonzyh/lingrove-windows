            "value": "Petakan bidang audio atau perbarui templat Lingrove."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Associa i campi audio o aggiorna il modello Lingrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声フィールドを割り当てるか、Lingrove テンプレートを更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 필드를 연결하거나 Lingrove 템플릿을 업데이트하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapeie os campos de áudio ou atualize o modelo do Lingrove."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сопоставьте аудиополя или обновите шаблон Lingrove."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses alanlarını eşleyin veya Lingrove şablonunu güncelleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请映射所选音频字段，或更新拾语模板。"
          }
