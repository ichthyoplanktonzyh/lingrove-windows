    "Speech for review audio: unavailable. Configure speech before preparing audio.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech for review audio: unavailable. Configure speech before preparing audio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复习音频语音服务不可用，请先配置语音。"
