<Window x:Class="Cotabby.App.UI.Vocabulary.VocabularyRestoreConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replace notebook?" Width="440" Height="205" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Theme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Replace notebook?" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="Replace this notebook with the selected backup, including images and Anki associations."
                   TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" Click="OnCancel" Padding="12,5" Margin="0,0,8,0" />
            <Button x:Name="RestoreButton" Content="Restore" Click="OnRestore" Padding="12,5" />
        </StackPanel>
    </StackPanel>
</Window>
