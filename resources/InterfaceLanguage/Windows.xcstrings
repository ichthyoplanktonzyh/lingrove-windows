    "Public endpoints must use HTTPS. HTTP is limited to this PC or the local network.": {
      "comment": "Windows platform adapter. Localizable.xcstrings / Public endpoints must use HTTPS. HTTP is limited to this Mac or the local network. at 3b53402f2cbc196b0398d133177fd80006d165b2; Mac becomes PC.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public endpoints must use HTTPS. HTTP is limited to this PC or the local network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公共端点必须使用 HTTPS。HTTP 仅限此 PC 或本地网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公開端點必須使用 HTTPS。HTTP 僅限此 PC 或區域網路使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開エンドポイントではHTTPSが必要です。HTTPはこのPCまたはローカルネットワークに限定されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 엔드포인트는 HTTPS를 사용해야 합니다. HTTP는 이 PC 또는 로컬 네트워크로 제한됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les endpoints publics doivent utiliser HTTPS. HTTP est limité à ce PC ou au réseau local."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffentliche Endpunkte müssen HTTPS verwenden. HTTP ist auf diesen PC oder das lokale Netzwerk beschränkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los endpoints públicos deben usar HTTPS. HTTP se limita a este PC o a la red local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoints públicos devem usar HTTPS. HTTP é limitado a este PC ou à rede local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli endpoint pubblici devono usare HTTPS. HTTP è limitato a questo PC o alla rete locale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общедоступные эндпоинты должны использовать HTTPS. HTTP разрешён только для этого PC или локальной сети."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تستخدم نقاط النهاية العامة HTTPS. يقتصر HTTP على جهاز PC هذا أو الشبكة المحلية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सार्वजनिक एंडपॉइंट को HTTPS का उपयोग करना चाहिए। HTTP इस PC या स्थानीय नेटवर्क तक सीमित है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoint publik harus menggunakan HTTPS. HTTP dibatasi untuk PC ini atau jaringan lokal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel uç noktalar HTTPS kullanmalıdır. HTTP bu PC veya yerel ağla sınırlıdır."
          }
        }
      }
    },
    "This server is outside your PC. Typed text and any enabled context will leave your device.": {
      "comment": "Windows platform adapter. Localizable.xcstrings / This server is outside your Mac. Typed text and any enabled context will leave your device. at 3b53402f2cbc196b0398d133177fd80006d165b2; Mac becomes PC.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server is outside your PC. Typed text and any enabled context will leave your device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器不在你的 PC 上。输入文本和任何已启用的上下文都会离开你的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器位於你的 PC 外部。輸入文字與任何啟用的內容都會離開你的裝置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーはPCの外部にあります。入力したテキストと有効にしたコンテキストがデバイス外に送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버는 PC 외부에 있습니다. 입력한 텍스트와 활성화된 모든 컨텍스트가 기기 밖으로 전송됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur se trouve en dehors de votre PC. Le texte saisi et tout contexte activé quitteront votre appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server befindet sich außerhalb deines PCs. Getippter Text und jeder aktivierte Kontext verlassen dein Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor está fuera de tu PC. El texto escrito y cualquier contexto activado saldrán de tu dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor está fora do PC. O texto digitado e qualquer contexto ativado sairão do seu dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server si trova fuori dal PC. Il testo digitato e qualsiasi contesto abilitato lasceranno il dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер находится за пределами вашего PC. Набираемый текст и любой включённый контекст покинут устройство."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الخادم خارج جهاز PC لديك. سيغادر النص المكتوب وأي سياق مفعّل جهازك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सर्वर आपके PC के बाहर है। टाइप किया गया टेक्स्ट और कोई भी सक्षम संदर्भ आपके डिवाइस से बाहर जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server ini berada di luar PC Anda. Teks yang diketik dan konteks yang diaktifkan akan meninggalkan perangkat Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucu PC'inizin dışındadır. Yazdığınız metin ve etkinleştirilmiş bağlam aygıtınızdan çıkar."
          }
        }
      }
    },
