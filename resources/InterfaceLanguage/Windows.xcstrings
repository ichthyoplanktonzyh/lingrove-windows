    "The selected text and its context are sent to this destination.": {
      "comment": "Windows authored-key adapter. Reuses Learning.xcstrings / With this endpoint, the service receives the chosen text, its captured context and the explanation language. at 3b53402f2cbc196b0398d133177fd80006d165b2.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected text and its context are sent to this destination."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此端点时，服务会收到所选内容、已获取的上下文和解释语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此端點時，服務會收到所選內容、已擷取的上下文和解釋語言。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエンドポイントのサービスには、選択したテキスト、取得した文脈、解説の言語が送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 엔드포인트 서비스에 선택한 텍스트, 수집한 문맥, 설명 언어가 전송됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec ce point de terminaison, le service reçoit le texte choisi, son contexte capturé et la langue d’explication."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei diesem Endpunkt erhält der Dienst den gewählten Text, den erfassten Kontext und die Erklärungssprache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con este endpoint, el servicio recibe el texto elegido, su contexto capturado y el idioma de explicación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com este endpoint, o serviço recebe o texto escolhido, o contexto capturado e o idioma da explicação."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con questo endpoint, il servizio riceve il testo scelto, il contesto acquisito e la lingua della spiegazione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При использовании этой конечной точки сервис получает выбранный текст, сохранённый контекст и язык объяснения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند استخدام نقطة النهاية هذه، تتلقى الخدمة النص المحدد وسياقه الملتقط ولغة الشرح."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस एंडपॉइंट का उपयोग करने पर सेवा को चुना गया पाठ, उसका प्राप्त संदर्भ और व्याख्या की भाषा भेजी जाती है।"
          }
        },
        "id": {
          "stringUnit": {
