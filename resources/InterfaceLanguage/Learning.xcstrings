        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LM Studioのライブラリ（~/.lmstudio/models）からモデルを上の選択欄に追加します。ダウンロード先は引き続きLingrove専用フォルダです。"
          }
