    "Double-click a word or expression to look it up": {
      "comment": "Windows authored-key adapter. Reuses Learning.xcstrings / Double-click a word or expression to open its contextual meaning. at 3b53402f2cbc196b0398d133177fd80006d165b2.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click a word or expression to look it up"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击单词或表达，查看它在当前语境中的含义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按兩下單字或表達，查看它在當前語境中的含義。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語や表現をダブルクリックし、文脈に合った意味を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어나 표현을 두 번 눌러 문맥 속 의미를 확인합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-cliquez sur un mot ou une expression pour voir son sens en contexte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelklicken Sie auf ein Wort oder einen Ausdruck, um die Bedeutung im Kontext zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic en una palabra o expresión para ver su significado en contexto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique duas vezes em uma palavra ou expressão para ver seu significado no contexto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai doppio clic su una parola o espressione per vederne il significato nel contesto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды нажмите на слово или выражение, чтобы узнать его значение в контексте."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر مرتين على كلمة أو تعبير لعرض معناه في السياق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदर्भ में अर्थ देखने के लिए शब्द या अभिव्यक्ति पर दो बार क्लिक करें।"
          }
        },
        "id": {
