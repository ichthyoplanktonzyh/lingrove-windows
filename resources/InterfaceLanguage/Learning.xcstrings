    "Record request timestamps, models and elapsed time. Only the most recent %lld requests are retained." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجل وقت الطلبات ونماذجها ومدتها. يتم الاحتفاظ بأحدث %lld طلبًا فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet Zeitstempel, Modelle und Dauer von Anfragen auf. Nur die letzten %lld Anfragen werden gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record request timestamps, models and elapsed time. Only the most recent %lld requests are retained."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra la fecha, el modelo y la duración de las solicitudes. Solo se conservan las %lld solicitudes más recientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre la date, le modèle et la durée des requêtes. Seules les %lld requêtes les plus récentes sont conservées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुरोधों का समय, मॉडल और अवधि रिकॉर्ड करें। केवल सबसे हाल के %lld अनुरोध रखे जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencatat waktu, model, dan durasi permintaan. Hanya %lld permintaan terbaru yang disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra data, modello e durata delle richieste. Vengono conservate solo le %lld richieste più recenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストの日時、モデル、所要時間を記録します。最新の %lld 件のみ保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청 시각, 모델 및 소요 시간을 기록합니다. 최근 %lld개 요청만 보관합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra data, modelo e duração das solicitações. Apenas as %lld solicitações mais recentes são mantidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает время, модель и длительность запросов. Хранятся только последние %lld запросов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsteklerin zamanını, modelini ve süresini kaydeder. Yalnızca son %lld istek saklanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录请求时间、模型和耗时。仅保留最近 %lld 次请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記錄請求時間、模型和耗時。僅保留最近 %lld 次請求。"
          }
        }
      }
    },
    "Record the timestamp, model, and elapsed time of every LLM request across completion, translation and analysis. Only the most recent %lld requests are retained." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل الطابع الزمني والنموذج والمدة المنقضية لكل طلب LLM عبر الإكمال والترجمة والتحليل. لا يحتفظ السجل إلا بأحدث %lld من الطلبات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitstempel, Modell und Dauer jeder LLM-Anfrage für Vervollständigung, Übersetzung und Analyse aufzeichnen. Nur die letzten %lld Anfragen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra la fecha y hora, el modelo y el tiempo transcurrido de cada solicitud al LLM para autocompletado, traducción y análisis. Solo se conservan las %lld solicitudes más recientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer l’horodatage, le modèle et la durée de chaque requête LLM pour l’autocomplétion, la traduction et l’analyse. Seules les %lld requêtes les plus récentes sont conservées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑटोकम्प्लीट, अनुवाद और विश्लेषण के हर LLM अनुरोध का टाइमस्टैम्प, मॉडल और लगा समय रिकॉर्ड करें। केवल पिछले %lld अनुरोध रखे जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catat waktu, model, dan durasi setiap permintaan LLM pada pelengkapan otomatis, terjemahan, dan analisis. Hanya %lld permintaan terbaru yang disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra data e ora, modello e tempo trascorso di ogni richiesta LLM per il completamento, la traduzione e l’analisi. Si conservano solo le richieste più recenti, fino a un massimo di %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "補完、翻訳、分析のすべてのLLMリクエストについて、タイムスタンプ、モデル、処理時間を記録します。直近%lld件だけを保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 완성, 번역 및 분석 전반에서 모든 LLM 요청의 시각, 모델, 경과 시간을 기록합니다. 최근 %lld개의 요청만 보관됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar a data e hora, o modelo e o tempo decorrido de cada solicitação ao LLM, incluindo preenchimento automático, tradução e análise. Somente as %lld solicitações mais recentes são mantidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывать временную метку, модель и длительность каждого запроса LLM для автодополнения, перевода и анализа. Сохраняются только последние %lld запросов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik tamamlama, çeviri ve analizdeki her LLM isteğinin zaman damgasını, modelini ve geçen süresini kaydedin. Yalnızca en son %lld istek saklanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录自动补全、翻译和分析的每个 LLM 请求的时间戳、模型和耗时。仅保留最近 %lld 个请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記錄自動完成、翻譯與分析中每次 LLM 要求的時間戳記、模型與耗時。只保留最近 %lld 筆要求。"
          }
        }
      }
    },
