    "The target remains the current sentence or your selection. Only reference text may be shortened to fit the budget." : {
      "comment" : "Distinguishes immutable translation target from bounded reference.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى الهدف الجملة الحالية أو التحديد. يمكن تقصير النص المرجعي فقط ليلائم الميزانية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziel bleibt der aktuelle Satz oder Ihre Auswahl. Nur Referenztext wird an das Budget angepasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The target remains the current sentence or your selection. Only reference text may be shortened to fit the budget."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El destino sigue siendo la frase actual o tu selección. Solo se recorta el contexto según el presupuesto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cible reste la phrase actuelle ou votre sélection. Seul le contexte peut être réduit selon le budget."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लक्ष्य वर्तमान वाक्य या आपका चयन रहता है। बजट के अनुसार केवल संदर्भ छोटा किया जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target tetap kalimat saat ini atau pilihan Anda. Hanya teks referensi yang boleh dipotong sesuai anggaran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo da tradurre resta la frase attuale o la selezione. Solo il riferimento può essere ridotto al budget."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対象は常に現在の文または選択範囲です。予算に合わせて短縮されるのは参照文だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상은 현재 문장 또는 선택 영역입니다. 예산에 맞춰 참고 텍스트만 줄일 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
