    "Applies when the local model next runs. Larger contexts use more memory; model limits still apply." : {
      "comment" : "Explains local runtime capacity and memory use.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُطبق عند التشغيل المحلي التالي. السياق الأكبر يستخدم ذاكرة أكثر؛ تبقى حدود النموذج سارية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt beim nächsten lokalen Modelllauf. Größerer Kontext braucht mehr Speicher; Modellgrenzen gelten weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies when the local model next runs. Larger contexts use more memory; model limits still apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica en la próxima ejecución local. Más contexto usa más memoria; se mantienen los límites del modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique à la prochaine exécution locale. Plus de contexte utilise plus de mémoire ; les limites du modèle restent valables."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लोकल मॉडल के अगले रन पर लागू होता है। बड़ा संदर्भ अधिक मेमोरी लेता है; मॉडल की सीमाएँ लागू रहती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berlaku saat model lokal dijalankan lagi. Konteks lebih besar memakai lebih banyak memori; batas model tetap berlaku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica alla prossima esecuzione locale. Più contesto usa più memoria; restano i limiti del modello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルモデルの次回実行時に適用します。文脈を増やすとメモリ使用量が増え、モデルの制限も適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 모델이 다음 실행될 때 적용됩니다. 큰 문맥은 더 많은 메모리를 사용하며 모델 제한이 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicado na próxima execução local. Mais contexto usa mais memória; os limites do modelo continuam válidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется при следующем запуске локальной модели. Больший контекст требует больше памяти; ограничения модели сохраняются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel modelin sonraki çalışmasında uygulanır. Büyük bağlam daha fazla bellek kullanır; model sınırları geçerlidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地模型下次运行时生效。更大的上下文占用更多内存，仍受模型限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本機模型下次執行時生效。較大的上下文使用更多記憶體，仍受模型限制。"
          }
        }
      }
    },
