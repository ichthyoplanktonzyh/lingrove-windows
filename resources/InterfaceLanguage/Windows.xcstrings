    "This action is unavailable while the notebook is busy or the store does not support it.": {
      "comment": "Windows authored interface copy; exact source, model, path and provider values remain arguments.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action is unavailable while the notebook is busy or the store does not support it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生词本正忙或存储不支持此操作时，无法使用此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
