  "styleBounds": [
    {
      "id": "style-bound-decomposed-graphemes",
      "macTest": "LearningTranslationStyleTests.customInstructionsAreBoundedWithoutChangingSource",
      "register": "custom",
      "customInput": {
        "repeat": {
          "text": "é",
          "count": 1001
        }
      },
      "expectedNormalized": {
        "repeat": {
          "text": "é",
          "count": 1000
        }
      },
      "expectedUtf8Bytes": 3000,
      "expectedGraphemes": 1000,
      "expectedContainsReplacement": false
    },
    {
      "id": "style-bound-byte-cut-replaces-incomplete-scalar",
      "macTest": "LearningGenerationProfile.swift LearningTranslationStyle.normalized (derived UTF-8 prefix probe)",
      "register": "custom",
      "customInput": {
        "concat": [
          {
            "repeat": {
              "text": "👩🏽‍💻",
              "count": 266
            }
          },
          "aa😀a😀"
        ]
      },
      "expectedNormalized": {
        "concat": [
          {
            "repeat": {
              "text": "👩🏽‍💻",
              "count": 266
            }
          },
          "aa😀a�"
        ]
      },
      "expectedUtf8Bytes": 4000,
      "expectedGraphemes": 271,
      "expectedContainsReplacement": true
    }
  ],
