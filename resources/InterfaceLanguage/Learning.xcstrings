    "Draw suggestions bold, italic, or both. Accepted text keeps the field’s own style." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض الاقتراحات بخط عريض أو مائل أو كليهما. يحتفظ النص المقبول بنمط الحقل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorschläge fett, kursiv oder beides anzeigen. Übernommener Text behält den Stil des Feldes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw suggestions bold, italic, or both. Accepted text keeps the field’s own style."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra las sugerencias en negrita, cursiva o ambas. El texto aceptado conserva el estilo del campo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher les suggestions en gras, en italique ou les deux. Le texte accepté conserve le style du champ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुझाव बोल्ड, इटैलिक या दोनों में दिखाएँ। स्वीकार किया गया टेक्स्ट फ़ील्ड की शैली रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan saran tebal, miring, atau keduanya. Teks yang diterima mengikuti gaya kolom."
          }
        },
        "it" : {
          "stringUnit" : {
