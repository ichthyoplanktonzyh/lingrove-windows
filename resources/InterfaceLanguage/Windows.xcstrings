    "Could not copy. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not copy. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
