        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence yazdığınız dili desteklemediğinde önerileri %@ ile oluşturur. Bu dillerde hiç öneri almamak için kapatın."
