    "Use a supported language code on line %lld, such as en or zh-Hans.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a supported language code on line %lld, such as en or zh-Hans."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 行请使用受支持的语言代码，例如 en 或 zh-Hans。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 行請使用支援的語言代碼，例如 en 或 zh-Hans。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld行目にはenやzh-Hansなどの対応言語コードを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld행에 en 또는 zh-Hans 같은 지원 언어 코드를 사용하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la ligne %lld, utilisez un code pris en charge, comme en ou zh-Hans."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Zeile %lld einen unterstützten Sprachcode wie en oder zh-Hans verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un código de idioma admitido en la línea %lld, como en o zh-Hans."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um código de idioma compatível na linha %lld, como en ou zh-Hans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un codice lingua supportato alla riga %lld, come en o zh-Hans."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В строке %lld укажите поддерживаемый код языка, например en или zh-Hans."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم رمز لغة مدعوماً في السطر %lld، مثل en أو zh-Hans."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंक्ति %lld में en या zh-Hans जैसा समर्थित भाषा कोड दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan kode bahasa yang didukung pada baris %lld, seperti en atau zh-Hans."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld. satırda en veya zh-Hans gibi desteklenen bir dil kodu kullanın."
          }
        }
      }
    },
