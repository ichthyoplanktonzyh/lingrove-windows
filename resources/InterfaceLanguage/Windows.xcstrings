    },
    "Use Lingrove in a compatible editor. If that editor runs as an administrator, Lingrove may need the same privilege level.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Lingrove in a compatible editor. If that editor runs as an administrator, Lingrove may need the same privilege level."
