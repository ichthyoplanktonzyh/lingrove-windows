    "Describe the expression or term in the temporary input, then pause." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِف التعبير أو المصطلح في حقل الإدخال المؤقت، ثم انتظر قليلًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreiben Sie den Ausdruck oder Begriff im temporären Eingabefeld und warten Sie kurz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe the expression or term in the temporary input, then pause."
          }
        },
        "es" : {
          "stringUnit" : {
