<Window x:Class="Cotabby.App.UI.Vocabulary.VocabularyNotebookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cotabby.App.UI.Vocabulary"
        Title="Vocabulary" Width="940" Height="640" MinWidth="760" MinHeight="460"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Theme.xaml" /></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BatchVisibility" />
            <HierarchicalDataTemplate DataType="{x:Type local:VocabularyEntryRow}" ItemsSource="{Binding Children}">
                <Border Background="Transparent" Padding="0,3" MaxWidth="330" MouseLeftButtonDown="OnEntryHeaderMouseDown" ContextMenuOpening="OnSenseExportMenuOpening">
                    <Border.ContextMenu><ContextMenu Opened="OnSenseExportMenuOpened" Closed="OnSenseExportMenuClosed"><MenuItem Header="Export this sense…" Click="OnExportSingle" /></ContextMenu></Border.ContextMenu>
                    <StackPanel>
                        <DockPanel Height="21" LastChildFill="True">
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding SingleSense.IsBatchSelected, Mode=TwoWay}" IsEnabled="{Binding SingleSense.BatchEnabled}"
                                      Visibility="{Binding ShowBatchCheckbox, Converter={StaticResource BatchVisibility}}" AutomationProperties.Name="{Binding SingleSense.BatchLabel}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SenseCount}" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LanguageLabel}" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="5,0,0,0" MaxWidth="70" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Expression}" FontWeight="SemiBold" FontSize="14" MaxWidth="210" MaxHeight="21" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Style.Triggers><DataTrigger Binding="{Binding IsEntrySelected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding SingleSense.Title}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0" MaxHeight="21" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Visibility="{Binding ShowInlineMeaning, Converter={StaticResource BatchVisibility}}" />
                        </DockPanel>
                        <TextBlock Text="{Binding DetailedMeaning}" FontSize="12" Height="18" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}"
                                   Visibility="{Binding ShowDetailedMeaning, Converter={StaticResource BatchVisibility}}" />
                        <TextBlock Text="{Binding Snippet}" FontSize="11" Height="16" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}"
                                   Visibility="{Binding HasSnippet, Converter={StaticResource BatchVisibility}}" />
                    </StackPanel>
                </Border>
            </HierarchicalDataTemplate>
            <DataTemplate DataType="{x:Type local:VocabularySenseRow}">
                <StackPanel Margin="0,4" MaxWidth="320" ContextMenuOpening="OnSenseExportMenuOpening">
                    <StackPanel.ContextMenu><ContextMenu Opened="OnSenseExportMenuOpened" Closed="OnSenseExportMenuClosed"><MenuItem Header="Export this sense…" Click="OnExportSingle" /></ContextMenu></StackPanel.ContextMenu>
                    <CheckBox IsChecked="{Binding IsBatchSelected, Mode=TwoWay}" IsEnabled="{Binding BatchEnabled}"
                              Visibility="{Binding Selecting, Converter={StaticResource BatchVisibility}}" AutomationProperties.Name="{Binding BatchLabel}" Margin="0,0,0,4" />
                    <DockPanel Height="20">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" FontWeight="Bold" FontSize="10" Width="20" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding UsageNumber}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{Binding Title}" FontSize="12" MaxHeight="20" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Snippet}" FontSize="11" Height="16" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="300" Margin="20,0,0,0"
                               Visibility="{Binding HasSnippet, Converter={StaticResource BatchVisibility}}" />
                </StackPanel>
            </DataTemplate>
            <Style TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="12">
            <StackPanel Orientation="Horizontal" Margin="0,0,8,0" AutomationProperties.Name="Browse vocabulary">
                <RadioButton x:Name="ListModeButton" Content="List" Tag="list" GroupName="VocabularyBrowserMode" Width="65" Style="{StaticResource Segment}" Checked="OnBrowserMode" IsChecked="True" />
                <RadioButton x:Name="GraphModeButton" Content="Graph" Tag="graph" GroupName="VocabularyBrowserMode" Width="65" Style="{StaticResource Segment}" Checked="OnBrowserMode" />
            </StackPanel>
            <TextBox x:Name="SearchText" Width="230" Padding="7,5" Margin="0,0,8,0" TextChanged="OnFiltersChanged" Style="{StaticResource Input}" Tag="Search vocabulary"
                     AutomationProperties.Name="Search vocabulary" Background="{DynamicResource InputBg}"
                     Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorder}" />
            <ToggleButton x:Name="SelectSensesButton" Content="Select senses" Padding="10,4" Margin="8,0,0,0" Checked="OnSelectSenses" Unchecked="OnSelectSenses" />
            <Button x:Name="SelectVisibleButton" Content="Select visible" Padding="10,4" Margin="8,0,0,0" Visibility="Collapsed" Click="OnSelectVisible" IsEnabled="False" />
            <Button x:Name="ExportSelectedButton" Content="Export selected…" Padding="10,4" Margin="8,0,0,0" Visibility="Collapsed" Click="OnExportSelected" IsEnabled="False" />
            <Button x:Name="ExportButton" Content="Export…" Padding="10,4" Margin="8,0,0,0" Click="OnExportNotebook" IsEnabled="False" />
            <Button x:Name="BackupButton" Content="Full notebook backup…" Padding="10,4" Margin="8,0,0,0" Click="OnBackupNotebook" IsEnabled="False" />
            <Button x:Name="RestoreNotebookButton" Content="Restore notebook…" Padding="10,4" Margin="8,0,0,0" Click="OnRestoreNotebook" IsEnabled="False" />
        </WrapPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,0,12,8">
            <Button x:Name="RetryBrowseButton" DockPanel.Dock="Right" Content="Retry" AutomationProperties.Name="Retry vocabulary browsing" Click="OnRetryBrowse" Visibility="Collapsed" Padding="10,4" Margin="8,0,0,0" />
            <TextBlock x:Name="StorageError" TextWrapping="Wrap" Foreground="{DynamicResource OrangeBrush}" Visibility="Collapsed" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="BrowserColumn" Width="290" MinWidth="230" MaxWidth="420" /><ColumnDefinition x:Name="DividerColumn" Width="5" /><ColumnDefinition x:Name="DetailColumn" Width="*" MinWidth="300" /></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Background="{DynamicResource SidebarBg}">
                <WrapPanel DockPanel.Dock="Top" Margin="8,6">
                    <ComboBox x:Name="LanguageFilter" Width="112" Margin="0,0,5,4" SelectionChanged="OnFiltersChanged" Style="{StaticResource Combo}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="Language" />
                    <ComboBox x:Name="TagFilter" Width="100" Margin="0,0,5,4" SelectionChanged="OnFiltersChanged" Style="{StaticResource Combo}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="Tags" />
                    <Button x:Name="ListDensityButton" Content="Compact list" Padding="7,3" Margin="0,0,5,0" Click="OnListDensity" AutomationProperties.Name="Vocabulary list density" />
                    <Button x:Name="SortButton" Content="Newest first" Padding="7,3" Click="OnSort" />
                </WrapPanel>
                <Grid>
                <TreeView x:Name="EntriesTree" Background="Transparent" BorderThickness="0" Padding="8"
                          SelectedItemChanged="OnSelectedItemChanged" PreviewKeyDown="OnEntryKeyDown" VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" />
                <TextBlock x:Name="EmptyText" Text="No saved expressions" TextWrapping="Wrap" Margin="24"
                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Grid x:Name="GraphHost" Visibility="Collapsed" />
                </Grid>
            </DockPanel>
            <GridSplitter x:Name="DetailDivider" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource CardBorder}" />
            <DockPanel x:Name="DetailsPane" Grid.Column="2">
                <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8">
                    <Button x:Name="CloseGraphDetailButton" Content="×" ToolTip="Close details" AutomationProperties.Name="Close details" Click="OnCloseGraphDetail" Padding="10,4" Margin="0,0,6,0" Visibility="Collapsed" />
                    <Button x:Name="EditButton" Content="Edit" Click="OnEdit" Padding="12,4" IsEnabled="False" />
                    <Button x:Name="NewSenseButton" Content="New sense" Click="OnNewSense" Padding="12,4" Margin="6,0,0,0" IsEnabled="False" />
                    <Button x:Name="MergeSenseButton" Content="Merge sense" Click="OnMergeSense" Padding="12,4" Margin="6,0,0,0" IsEnabled="False" />
                    <Button x:Name="DeleteSenseButton" Content="Delete" Click="OnDeleteSense" Padding="12,4" Margin="6,0,0,0" IsEnabled="False" />
                </WrapPanel>
                <ScrollViewer x:Name="DetailViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DetailContent" Margin="24" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
