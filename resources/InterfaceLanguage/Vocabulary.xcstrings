    "This example belongs to another sense. Match its saved meaning or edit it in the notebook.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This example belongs to another sense. Match its saved meaning or edit it in the notebook."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条例句已属于另一个义项。请使用其已有释义，或在生词本中编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個例句已屬於另一個義項。請使用其既有釋義，或在生詞本中編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この例文は別の語義に属しています。保存済みの意味に合わせるか、単語帳で編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 예문은 다른 뜻에 속합니다. 저장된 의미와 맞추거나 단어장에서 편집하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet exemple appartient à une autre acception. Utilisez son sens enregistré ou modifiez-le dans le carnet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Beispiel gehört zu einer anderen Bedeutung. Gespeicherte Bedeutung übernehmen oder im Vokabelheft bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ejemplo pertenece a otra acepción. Usa su significado guardado o edítalo en el cuaderno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este exemplo pertence a outra acepção. Use o significado salvo ou edite no caderno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo esempio appartiene a un’altra accezione. Usa il significato salvato o modificalo nel quaderno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот пример относится к другому значению. Укажите сохранённое значение или измените его в словаре."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المثال ينتمي إلى دلالة أخرى. طابق معناه المحفوظ أو عدّله في الدفتر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उदाहरण किसी दूसरे अर्थ-खंड का है। सहेजे गए अर्थ से मिलाएँ या शब्दावली में संपादित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Contoh ini milik arti lain. Gunakan makna tersimpan atau edit di buku kosakata."
          }
        },
        "tr": {
