    "Reading translation leaves the original text unchanged. Screen OCR requires Screen Recording permission." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يغيّر ترجمة النص أثناء القراءة الأصل. يتطلب OCR الشاشة إذن تسجيل الشاشة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Leseübersetzung verändert den Originaltext nicht. Bildschirm-OCR benötigt die Berechtigung zur Bildschirmaufnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reading translation leaves the original text unchanged. Screen OCR requires Screen Recording permission."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La traducción de lectura no modifica el original. El OCR de pantalla requiere permiso de grabación de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La traduction en lecture ne modifie pas l’original. L’OCR d’écran nécessite l’autorisation d’enregistrement de l’écran."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पढ़ने के लिए किया गया अनुवाद मूल पाठ नहीं बदलता। स्क्रीन OCR के लिए स्क्रीन रिकॉर्डिंग की अनुमति चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjemahan bacaan tidak mengubah teks asli. OCR layar memerlukan izin perekaman layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La traduzione in lettura non modifica l’originale. L’OCR dello schermo richiede il permesso di registrazione dello schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読むための翻訳は原文を変更しません。画面 OCR には画面収録権限が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽기 번역은 원문을 변경하지 않습니다. 화면 OCR에는 화면 기록 권한이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tradução de leitura não altera o original. O OCR da tela exige permissão de gravação da tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевод при чтении не меняет оригинал. Для экранного OCR нужно разрешение на запись экрана."
          }
        },
        "tr" : {
          "stringUnit" : {
