    "Could not restart Lingrove. Please open the application again.": {
      "comment": "Finite Windows authored-copy adapter: Learning.xcstrings / Lingrove could not restart. Quit and reopen it to apply the selected language. at 3b53402f2cbc196b0398d133177fd80006d165b2.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not restart Lingrove. Please open the application again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾语无法重启。请退出并重新打开拾语，以应用所选语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拾語無法重新啟動。請結束並重新開啟拾語，以套用所選語言。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingroveを再起動できませんでした。選択した言語を適用するには、Lingroveを終了して再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove를 재시동하지 못했습니다. 선택한 언어를 적용하려면 Lingrove를 종료한 뒤 다시 실행하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove n’a pas pu redémarrer. Quittez puis rouvrez l’app pour appliquer la langue choisie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove konnte nicht neu gestartet werden. Beende die App und öffne sie erneut, um die ausgewählte Sprache anzuwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reiniciar Lingrove. Cierra la app y vuelve a abrirla para aplicar el idioma seleccionado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível reiniciar o Lingrove. Feche o app e abra-o novamente para aplicar o idioma selecionado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove non è riuscito a riavviarsi. Chiudi e riapri l’app per applicare la lingua selezionata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось перезапустить Lingrove. Закройте Lingrove и откройте его снова, чтобы применить выбранный язык."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت إعادة تشغيل Lingrove. أغلق Lingrove ثم افتحه مجددًا لتطبيق اللغة المحددة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove को फिर से शुरू नहीं किया जा सका। चुनी गई भाषा लागू करने के लिए इसे बंद करके फिर खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove tidak dapat dimulai ulang. Tutup lalu buka kembali Lingrove untuk menerapkan bahasa yang dipilih."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove yeniden başlatılamadı. Seçilen dili uygulamak için uygulamayı kapatıp yeniden açın."
          }
        }
      }
    },
