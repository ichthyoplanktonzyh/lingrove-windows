    "Choose an instruction-tuned model for chunk alignment. Base continuation models are not suited to this task." : {
      "comment" : "Instruction above the local model picker for chunk alignment.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر نموذجًا مضبوطًا على اتباع التعليمات لمطابقة العبارات. لا تصلح نماذج الإكمال الأساسي لهذه المهمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle für die Phrasenzuordnung ein instruktionsoptimiertes Modell aus. Basismodelle zur Textfortsetzung eignen sich nicht für diese Aufgabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un modelo ajustado para seguir instrucciones y realizar la correspondencia de frases. Los modelos base de continuación no son adecuados para esta tarea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un modèle ajusté pour suivre des instructions pour la correspondance des expressions. Les modèles de continuation de base ne conviennent pas à cette tâche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वाक्यांश मिलान के लिए निर्देशों के अनुसार ट्यून किया गया मॉडल चुनें। दिए गए पाठ को आगे जारी रखने वाले Base मॉडल इस काम के लिए उपयुक्त नहीं हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih model yang mengikuti instruksi untuk pencocokan frasa. Model dasar untuk melanjutkan teks tidak cocok untuk tugas ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un modello ottimizzato per seguire istruzioni per l’allineamento delle frasi. I modelli base di continuazione non sono adatti a questa attività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フレーズ照合には指示チューニング済みモデルを選択してください。ベース継続モデルはこのタスクに適していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
