<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Cotabby.Win32</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <ProjectReference Include="..\Cotabby.Core\Cotabby.Core.csproj" />
    <ProjectReference Include="..\Cotabby.Inference\Cotabby.Inference.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Speech\Notices\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
