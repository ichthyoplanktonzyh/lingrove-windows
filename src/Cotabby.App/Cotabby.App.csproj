<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Cotabby.App</RootNamespace>
    <AssemblyName>Cotabby</AssemblyName>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>Assets\Cotabby.ico</ApplicationIcon>
    <Version>0.6.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\CotabbyLogo.png" />
    <Resource Include="Assets\MenuBarCatIcon.png" />
    <Resource Include="Assets\MenuBarCatIcon@3x.png" />
    <Resource Include="Assets\Cotabby.ico" />
    <Content Include="..\..\resources\LearningLexicon\learning-expressions*"
             Link="Resources\LearningLexicon\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cotabby.Core\Cotabby.Core.csproj" />
    <ProjectReference Include="..\Cotabby.Inference\Cotabby.Inference.csproj" />
    <ProjectReference Include="..\Cotabby.Win32\Cotabby.Win32.csproj" />
    <ProjectReference Include="..\Cotabby.ImageTransferHost\Cotabby.ImageTransferHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Cotabby.Cli\Cotabby.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The explicit user-installed command borrows these app-local CLI sidecars. -->
    <Content Include="..\Cotabby.Cli\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\lingrove.exe" Link="lingrove.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Cotabby.Cli\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\lingrove.dll" Link="lingrove.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Cotabby.Cli\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\lingrove.deps.json" Link="lingrove.deps.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Cotabby.Cli\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\lingrove.runtimeconfig.json" Link="lingrove.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The process boundary is part of the app's ordinary build, not a release/package job.
         Content metadata also carries these four sidecars into the WPF test output. -->
    <Content Include="..\Cotabby.ImageTransferHost\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\Cotabby.ImageTransferHost.exe"
             Link="Cotabby.ImageTransferHost.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Cotabby.ImageTransferHost\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\Cotabby.ImageTransferHost.dll"
             Link="Cotabby.ImageTransferHost.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Cotabby.ImageTransferHost\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\Cotabby.ImageTransferHost.deps.json"
             Link="Cotabby.ImageTransferHost.deps.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Cotabby.ImageTransferHost\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\Cotabby.ImageTransferHost.runtimeconfig.json"
             Link="Cotabby.ImageTransferHost.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
