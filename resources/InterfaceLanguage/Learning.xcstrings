    "Enable text access, global shortcuts, and optional screen OCR. You can set these up later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى النص والاختصارات العامة والتعرّف الاختياري على نص الشاشة. يمكنك إعداد ذلك لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textzugriff, globale Kurzbefehle und optionales Bildschirm-OCR erlauben. Dies ist auch später möglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable text access, global shortcuts, and optional screen OCR. You can set these up later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso al texto, los atajos globales y, opcionalmente, el OCR de pantalla. Puedes hacerlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès au texte, les raccourcis globaux et, en option, l’OCR à l’écran. Vous pourrez le faire plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेक्स्ट ऐक्सेस, वैश्विक शॉर्टकट और वैकल्पिक स्क्रीन OCR की अनुमति दें। इन्हें बाद में भी सेट कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan akses teks, pintasan global, dan OCR layar opsional. Anda dapat mengaturnya nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l’accesso al testo, le scorciatoie globali e l’OCR dello schermo facoltativo. Puoi farlo anche dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストへのアクセス、グローバルショートカット、任意の画面OCRを許可します。後で設定することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 접근, 전역 단축키와 선택적 화면 OCR을 허용하세요. 나중에 설정할 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso ao texto, os atalhos globais e, opcionalmente, o OCR de tela. Você pode configurar isso depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к тексту, глобальные сочетания и, при желании, OCR экрана. Это можно настроить позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin erişimine, genel kısayollara ve isteğe bağlı ekran OCR’sine izin verin. Bunları daha sonra da ayarlayabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授权文字访问、全局快捷键和可选的屏幕 OCR，也可稍后设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授權文字存取、全域快捷鍵和可選的螢幕 OCR，也可稍後設定。"
          }
        }
      }
    },
    "Enable translation in the Translation tab to use chunk alignment." : {
      "comment" : "Explains why chunk alignment is disabled when translation is off in its separate tab.",
      "extractionState" : "manual",
      "localizations" : {
