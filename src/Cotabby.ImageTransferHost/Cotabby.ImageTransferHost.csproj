<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- One shared implementation, no WPF/AppHost/model runtime in the extraction process. -->
    <Compile Include="..\Cotabby.Win32\Clipboard\ClipboardNativeMethods.cs" Link="ClipboardNativeMethods.cs" />
    <Compile Include="..\Cotabby.Win32\Vocabulary\VocabularyClipboardImageReader.cs" Link="VocabularyClipboardImageReader.cs" />
    <Compile Include="..\Cotabby.Win32\Vocabulary\VocabularyClipboardDib.cs" Link="VocabularyClipboardDib.cs" />
    <Compile Include="..\Cotabby.Win32\Vocabulary\VocabularyImageTransferProtocol.cs" Link="VocabularyImageTransferProtocol.cs" />
  </ItemGroup>
</Project>
