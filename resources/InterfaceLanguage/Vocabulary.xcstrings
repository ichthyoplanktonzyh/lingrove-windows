    "Preview the list before adding it. Existing entries and notes are kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview the list before adding it. Existing entries and notes are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认预览后再导入。已有词条和备注会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認預覽後再匯入。既有詞條和備註會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加前にリストを確認してください。既存の項目とメモは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가하기 전에 목록을 미리 확인하세요. 기존 항목과 메모는 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévisualisez la liste avant l’ajout. Les entrées et notes existantes sont conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste vor dem Hinzufügen prüfen. Vorhandene Einträge und Notizen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la lista antes de añadirla. Se conservan las entradas y notas existentes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira a lista antes de adicionar. As entradas e notas existentes são mantidas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla l’elenco prima di aggiungerlo. Voci e note esistenti vengono conservate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте список перед добавлением. Существующие записи и заметки сохраняются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاين القائمة قبل إضافتها. تُحفظ المدخلات والملاحظات الحالية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़ने से पहले सूची देखें। मौजूदा प्रविष्टियाँ और नोट्स बने रहेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau daftar sebelum menambahkannya. Entri dan catatan yang ada tetap disimpan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklemeden önce listeyi önizleyin. Mevcut girdiler ve notlar korunur."
          }
        }
      }
    },
    "Save the word list as UTF-8 or UTF-16 text and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the word list as UTF-8 or UTF-16 text and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将词表保存为 UTF-8 或 UTF-16 文本后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將詞表儲存為 UTF-8 或 UTF-16 文字後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8またはUTF-16のテキストで保存して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어 목록을 UTF-8 또는 UTF-16 텍스트로 저장한 후 다시 시도하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez la liste en texte UTF-8 ou UTF-16, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wortliste als UTF-8- oder UTF-16-Text speichern und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda la lista como texto UTF-8 o UTF-16 e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve a lista como texto UTF-8 ou UTF-16 e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva l’elenco come testo UTF-8 o UTF-16 e riprova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните список в UTF-8 или UTF-16 и повторите попытку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ القائمة كنص UTF-8 أو UTF-16 ثم أعد المحاولة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शब्द सूची को UTF-8 या UTF-16 टेक्स्ट के रूप में सहेजकर फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
