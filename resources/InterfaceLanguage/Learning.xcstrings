          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на динамик рядом со словом, выражением или предложением. Язык определяется по тексту."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sözcük, ifade veya cümlenin yanındaki hoparlöre tıklayın. Dil, metinden otomatik algılanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
