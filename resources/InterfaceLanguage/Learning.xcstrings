    "Apple Intelligence manages its own capacity. This setting bounds the context Lingrove supplies." : {
      "comment" : "Apple model input budgeting does not resize the system model.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدير Apple Intelligence سعته ذاتيًا. يحد هذا الإعداد السياق الذي يوفره Lingrove."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence verwaltet seine Kapazität selbst. Diese Einstellung begrenzt Lingroves Kontext."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence manages its own capacity. This setting bounds the context Lingrove supplies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence gestiona su capacidad. Este ajuste limita el contexto que aporta Lingrove."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence gère sa capacité. Ce réglage limite le contexte fourni par Lingrove."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence अपनी क्षमता स्वयं प्रबंधित करता है। यह सेटिंग Lingrove का दिया संदर्भ सीमित करती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence mengelola kapasitasnya sendiri. Pengaturan ini membatasi konteks dari Lingrove."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence gestisce la propria capacità. L’impostazione limita il contesto fornito da Lingrove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence の容量はシステムが管理します。この設定は Lingrove が渡す文脈を制限します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence의 용량은 시스템이 관리합니다. 이 설정은 Lingrove가 제공하는 문맥을 제한합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple Intelligence gerencia sua capacidade. Este ajuste limita o contexto enviado pelo Lingrove."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ёмкостью Apple Intelligence управляет система. Настройка ограничивает контекст от Lingrove."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence kapasitesini kendi yönetir. Bu ayar Lingrove’un sağladığı bağlamı sınırlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 的容量由系统管理；此设置限制拾语提供的上下文。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 的容量由系統管理；此設定限制拾語提供的上下文。"
          }
        }
      }
    },
    "Apple Intelligence rejected a guided-generation request Lingrove sent." : {
      "comment" : "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض Apple Intelligence طلب التوليد الموجّه الذي أرسله Lingrove."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence hat eine von Lingrove gesendete Anfrage zur geführten Generierung abgelehnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence rechazó una solicitud de generación guiada enviada por Lingrove."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence a refusé une requête de génération guidée envoyée par Lingrove."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ने Lingrove द्वारा भेजे गए निर्देशित-जनरेशन अनुरोध को अस्वीकार कर दिया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence menolak permintaan pembuatan terpandu yang dikirim Lingrove."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ha rifiutato una richiesta di generazione guidata inviata da Lingrove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple IntelligenceはLingroveが送信したガイド付き生成リクエストを拒否しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
