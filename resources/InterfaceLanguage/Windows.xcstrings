    "No apps are disabled. Lingrove is active in every supported field.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No apps are disabled. Lingrove is active in every supported field."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未禁用任何应用，Lingrove 可在所有受支持的输入框中使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未停用任何應用程式，Lingrove 可在所有受支援的輸入欄位中使用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تطبيقات مستثناة. يعمل Lingrove في كل الحقول المدعومة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Apps deaktiviert. Lingrove ist in jedem unterstützten Feld aktiv."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay apps desactivadas. Lingrove está activo en todos los campos compatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app n’est désactivée. Lingrove est actif dans tous les champs pris en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई ऐप अक्षम नहीं है। Lingrove हर समर्थित फ़ील्ड में सक्रिय है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada app yang dinonaktifkan. Lingrove aktif di setiap bidang yang didukung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna app disabilitata. Lingrove è attivo in ogni campo supportato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なアプリはありません。Lingroveはサポートされるすべての入力欄で有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비활성화된 앱이 없습니다. Lingrove는 지원되는 모든 필드에서 활성화되어 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum app está desativado. O Lingrove está ativo em todos os campos compatíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключённых приложений нет. Lingrove активен во всех поддерживаемых полях."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir uygulama devre dışı değil. Lingrove desteklenen her alanda etkin."
          }
        }
      },
      "comment": "Windows authored key reuses Learning.xcstrings: No apps are disabled. Lingrove is active in every supported field. at Mac 3b53402f2cbc196b0398d133177fd80006d165b2. Existing Windows translations retain their platform wording."
