        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在兼容的编辑器中使用 Lingrove。若编辑器以管理员身份运行，Lingrove 可能也需要相同权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在相容的編輯器中使用 Lingrove。若編輯器以系統管理員身分執行，Lingrove 可能也需要相同權限。"
          }
        }
      }
    },
