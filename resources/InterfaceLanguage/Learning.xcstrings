    },
    "Use the host text size, with a 9 pt readability minimum. The size controls below are ignored while enabled." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام حجم نص الحقل بحد أدنى 9 نقاط للوضوح. تُتجاهل إعدادات الحجم أدناه عند التفعيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textgröße des Eingabefeldes verwenden, mindestens 9 pt für die Lesbarkeit. Die folgenden Größenregler werden dabei ignoriert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the host text size, with a 9 pt readability minimum. The size controls below are ignored while enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el tamaño del texto del campo, con un mínimo legible de 9 pt. Al activarlo se ignoran los controles de tamaño inferiores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser la taille du texte du champ, avec un minimum lisible de 9 pt. Les réglages de taille ci-dessous sont alors ignorés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ील्ड के टेक्स्ट का आकार अपनाएँ, पढ़ने के लिए कम से कम 9 pt रखें। चालू होने पर नीचे के आकार नियंत्रण लागू नहीं होंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan ukuran teks kolom, minimal 9 pt agar terbaca. Saat aktif, kontrol ukuran di bawah diabaikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la dimensione del testo del campo, con un minimo leggibile di 9 pt. Quando attivo, ignora i controlli di dimensione seguenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力先の文字サイズを使用します。読みやすさのため最小は9ptです。有効時は下のサイズ設定を無視します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력 앱의 텍스트 크기를 사용하며 가독성을 위해 최소 9pt를 유지합니다. 켜면 아래 크기 설정을 무시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o tamanho do texto do campo, com mínimo de 9 pt para leitura. Quando ativado, ignora os controles de tamanho abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать размер текста поля, но не менее 9 пт для читаемости. При включении настройки размера ниже не применяются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alan metninin boyutunu, okunabilirlik için en az 9 punto olarak kullanır. Etkinken aşağıdaki boyut denetimleri uygulanmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用宿主文字的字号，最小为 9 磅以保持可读性。开启后将忽略下方的字号控件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用宿主文字的字級，最小為 9 點以保持可讀性。開啟後會忽略下方的字級控制項。"
          }
        }
      }
    },
