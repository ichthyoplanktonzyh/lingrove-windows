    "On keeps the global auto-fix choice; Off disables typo checks in this app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التشغيل يحافظ على اختيار التصحيح التلقائي العام؛ والإيقاف يعطل فحص الأخطاء في هذا التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein übernimmt die globale Autokorrekturwahl; Aus deaktiviert die Tippfehlerprüfung in dieser App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On keeps the global auto-fix choice; Off disables typo checks in this app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado conserva la opción global de autocorrección; Desactivado apaga la revisión de errores en esta aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé conserve le choix global de correction automatique ; Désactivé coupe la vérification dans cette app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चालू होने पर वैश्विक ऑटो-फ़िक्स विकल्प रहेगा; बंद होने पर इस ऐप की टाइपो जाँच रुक जाएगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktif mengikuti pilihan perbaikan otomatis global; Nonaktif mematikan pemeriksaan salah ketik aplikasi ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivo mantiene la scelta globale di correzione automatica; Disattivo spegne il controllo dei refusi in questa app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンでは全体の自動修正設定に従い、オフではこのアプリの誤字チェックを無効にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 전역 자동 수정 설정을 따르고, 끄면 이 앱의 오타 검사를 중지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativado mantém a opção global de correção automática; Desativado desliga a verificação de erros neste app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкл. сохраняет общую настройку автозамены; Выкл. отключает проверку опечаток в приложении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık, genel otomatik düzeltme seçimini korur; Kapalı, bu uygulamanın yazım denetimini kapatır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启时沿用全局自动替换设置；关闭时停用此应用的拼写检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟時沿用全域自動取代設定；關閉時停用此應用程式的拼字檢查。"
          }
        }
      }
    },
