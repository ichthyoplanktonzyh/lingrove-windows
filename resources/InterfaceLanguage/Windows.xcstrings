    "The saved voice is unavailable. An available voice will be used until you choose another.": {
      "comment": "Windows authored-key adapter. Reuses Learning.xcstrings / The saved voice is unavailable. Lingrove will use an available voice until you choose another. at 3b53402f2cbc196b0398d133177fd80006d165b2.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved voice is unavailable. An available voice will be used until you choose another."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的语音不可用。在你选择其他语音前，拾语会使用一个可用语音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的語音無法使用。在你選擇其他語音前，拾語會使用可用語音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した音声は利用できません。別の音声を選ぶまで、Lingroveは利用可能な音声を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 음성을 사용할 수 없습니다. 다른 음성을 선택할 때까지 Lingrove가 사용 가능한 음성을 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix enregistrée n’est pas disponible. Lingrove utilisera une voix disponible jusqu’à ce que vous en choisissiez une autre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Stimme ist nicht verfügbar. Lingrove verwendet eine verfügbare Stimme, bis du eine andere auswählst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz guardada no está disponible. Lingrove usará una voz disponible hasta que elijas otra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz salva não está disponível. O Lingrove usará uma voz disponível até você escolher outra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La voce salvata non è disponibile. Lingrove ne userà una disponibile finché non ne sceglierai un’altra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённый голос недоступен. Lingrove будет использовать доступный голос, пока вы не выберете другой."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصوت المحفوظ غير متاح. سيستخدم Lingrove صوتًا متاحًا إلى أن تختار صوتًا آخر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजी गई आवाज़ उपलब्ध नहीं है। आपके दूसरी आवाज़ चुनने तक Lingrove उपलब्ध आवाज़ का उपयोग करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara tersimpan tidak tersedia. Lingrove akan menggunakan suara yang tersedia sampai Anda memilih suara lain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen ses kullanılamıyor. Siz başka bir ses seçene kadar Lingrove kullanılabilir bir sesi kullanacak."
          }
        }
      }
    },
