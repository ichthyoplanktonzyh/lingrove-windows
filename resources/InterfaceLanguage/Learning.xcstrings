          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um modelo ajustado para seguir instruções para corresponder trechos entre frases. Modelos base de continuação não são adequados para esta tarefa."
          }
