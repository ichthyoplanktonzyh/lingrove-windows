    "Keep Lingrove's icon in the menu bar. If hidden, open Lingrove again to show Settings." : {
      "comment" : "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ أيقونة Lingrove في شريط القوائم. إذا كانت مخفية، افتح Lingrove مجددًا لإظهار الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingroves Symbol in der Menüleiste behalten. Wenn es ausgeblendet ist, öffne Lingrove erneut, um die Einstellungen anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el icono de Lingrove en la barra de menús. Si está oculto, vuelve a abrir Lingrove para mostrar Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserver l’icône de Lingrove dans la barre des menus. Si elle est masquée, ouvrez à nouveau Lingrove pour afficher Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingrove का आइकन मेनू बार में रखें। छिपा होने पर सेटिंग्ज़ दिखाने के लिए Lingrove फिर खोलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pertahankan ikon Lingrove di bar menu. Jika disembunyikan, buka Lingrove lagi untuk menampilkan Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni l'icona di Lingrove nella barra dei menu. Se è nascosta, apri di nuovo Lingrove per mostrare le Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingroveのアイコンをメニューバーに保持します。非表示にした場合は、Lingroveをもう一度開いて設定を表示してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingrove 아이콘을 메뉴 막대에 유지합니다. 숨긴 경우 Lingrove를 다시 열어 설정을 표시하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter o ícone do Lingrove na barra de menus. Se o ícone estiver oculto, abra o Lingrove novamente para mostrar os Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставлять значок Lingrove в строке меню. Если он скрыт, снова откройте Lingrove, чтобы показать настройки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingrove'nin simgesini menü çubuğunda tutun. Gizliyse Ayarlar'ı göstermek için Lingrove'yi yeniden açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持拾语图标显示在菜单栏中。如果隐藏，再次打开拾语即可显示设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓拾語的圖像保留在選單列中。若已隱藏，請再次開啟拾語以顯示「設定」。"
          }
        }
      }
    },
    "Keep someone informed about new developments." : {
