    "Shows or hides details. Without a preview, requests the selected text or current sentence." : {
      "comment" : "Explains the explicit preview and detail command.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض التفاصيل أو يخفيها. عند عدم وجود معاينة يترجم النص المحدد أو الجملة الحالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt oder verbirgt Details. Ohne Vorschau wird die Auswahl oder der aktuelle Satz übersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows or hides details. Without a preview, requests the selected text or current sentence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra u oculta detalles. Sin vista previa, traduce la selección o la frase actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche ou masque les détails. Sans aperçu, traduit la sélection ou la phrase actuelle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विवरण दिखाता या छिपाता है। पूर्वावलोकन न हो तो चयन या वर्तमान वाक्य का अनुवाद करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan atau menyembunyikan detail. Tanpa pratinjau, menerjemahkan pilihan atau kalimat saat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o nasconde i dettagli. Senza anteprima, traduce la selezione o la frase attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細を表示／非表示にします。プレビューがなければ選択範囲または現在の文を翻訳します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세부 정보를 표시하거나 숨깁니다. 미리보기가 없으면 선택한 텍스트 또는 현재 문장을 번역합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra ou oculta detalhes. Sem prévia, traduz a seleção ou a frase atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает или скрывает подробности. Без предпросмотра переводит выделение или текущее предложение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrıntıları gösterir veya gizler. Önizleme yoksa seçimi ya da geçerli cümleyi çevirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展开或收起详情；没有预览时，翻译选区或当前句。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展開或收合詳細資訊；沒有預覽時，翻譯選取範圍或目前句子。"
          }
        }
      }
    },
    "Shows the active selection. Downloaded models must also be selected here." : {
      "comment" : "Explains that downloading a model does not select it automatically.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض الاختيار النشط. ويجب أيضًا تحديد النماذج التي تم تنزيلها هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die aktive Auswahl. Heruntergeladene Modelle müssen auch hier ausgewählt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la selección activa. Los modelos descargados también deben seleccionarse aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la sélection active. Les modèles téléchargés doivent également être sélectionnés ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सक्रिय चयन दिखाता है। डाउनलोड किए गए मॉडल को भी यहाँ चुनना होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan pilihan aktif. Model yang diunduh juga harus dipilih di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra la selezione attiva. I modelli scaricati devono essere selezionati anche qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択内容を表示します。ダウンロード済みモデルもここで選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성 선택 영역을 표시합니다. 다운로드한 모델도 여기에서 선택해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra a seleção ativa. Também é preciso selecionar aqui os modelos baixados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь показана выбранная модель. Загруженные модели тоже нужно выбрать в этом списке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkin seçimi gösterir. İndirilen modellerin de burada seçilmesi gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示当前选择的模型。下载的模型也必须在此处选中才能使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示目前使用的模型。下載模型後，還必須在此選取模型。"
          }
        }
      }
    },
    "Shows whether this task's local model is loaded and ready to generate." : {
      "comment" : "Description of the local model status field.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوضح ما إذا كان النموذج المحلي لهذه المهمة محمّلًا وجاهزًا للتوليد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt an, ob das lokale Modell dieser Aufgabe geladen und für die Generierung bereit ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica si el modelo local de esta tarea está cargado y listo para generar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique si le modèle local de cette tâche est chargé et prêt à générer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिखाता है कि इस कार्य का स्थानीय मॉडल लोड है और जनरेट करने के लिए तैयार है या नहीं।"
