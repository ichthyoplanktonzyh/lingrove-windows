    "Sends only the lookup term after explicit action": {
      "comment": "Windows authored interface copy; exact source, model, path and provider values remain arguments.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends only the lookup term after explicit action"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
