    "Select a saved sense and add a card. You can also update an existing card." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد معنى محفوظًا وأضف بطاقة. يمكنك أيضًا تحديث بطاقة موجودة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie eine gespeicherte Bedeutung und fügen Sie eine Karte hinzu. Bestehende Karten lassen sich ebenfalls aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select a saved sense and add a card. You can also update an existing card."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona una acepción guardada y añade una tarjeta. También puedes actualizar una tarjeta existente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un sens enregistré et ajoutez une carte. Vous pouvez aussi mettre à jour une carte existante."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजा गया अर्थ चुनकर कार्ड जोड़ें। मौजूदा कार्ड भी अपडेट कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
