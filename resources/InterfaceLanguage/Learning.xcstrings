    "Selections take priority. Reference context never expands the replacement range." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للنص المحدد الأولوية. لا يوسّع السياق المرجعي نطاق الاستبدال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Auswahl hat Vorrang. Der Referenzkontext erweitert den Ersetzungsbereich nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selections take priority. Reference context never expands the replacement range."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La selección tiene prioridad. El contexto de referencia nunca amplía el fragmento que se sustituye."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sélection est prioritaire. Le contexte de référence n’élargit jamais la zone remplacée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चयन को प्राथमिकता मिलती है। संदर्भ बदलने वाले पाठ का दायरा नहीं बढ़ाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks yang dipilih diprioritaskan. Konteks referensi tidak memperluas bagian yang diganti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La selezione ha la priorità. Il contesto di riferimento non estende mai il testo da sostituire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択範囲が優先されます。参照文脈を広げても置換範囲は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 영역이 우선합니다. 참고 문맥은 바꿀 범위를 넓히지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A seleção tem prioridade. O contexto de referência nunca amplia o trecho substituído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
