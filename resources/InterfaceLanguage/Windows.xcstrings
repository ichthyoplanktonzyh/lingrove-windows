            "value": "Windows üzerinde kullanılamıyor"
          }
        }
      }
    },
    "Choose source priority and languages. Imported files stay in their original location.": {
      "comment": "Windows authored interface copy; exact source, model, path and provider values remain arguments.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose source priority and languages. Imported files stay in their original location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择来源优先级和语言，导入的文件仍保留在原位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇來源優先順序和語言，匯入的檔案仍保留在原位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースの優先順位と言語を選びます。インポートしたファイルは元の場所に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스 우선순위와 언어를 선택하세요. 가져온 파일은 원래 위치에 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la priorité des sources et les langues. Les fichiers importés restent à leur emplacement d’origine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Quellenpriorität und Sprachen. Importierte Dateien bleiben am ursprünglichen Ort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la prioridad de fuentes y los idiomas. Los archivos importados permanecen en su ubicación original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a prioridade das fontes e os idiomas. Os arquivos importados permanecem no local original."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la priorità delle fonti e le lingue. I file importati restano nella posizione originale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите приоритет источников и языки. Импортированные файлы остаются на прежнем месте."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أولوية المصادر واللغات. تبقى الملفات المستوردة في موقعها الأصلي."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्रोत प्राथमिकता और भाषाएँ चुनें। आयातित फ़ाइलें अपनी मूल जगह रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih prioritas sumber dan bahasa. Berkas impor tetap di lokasi asalnya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak önceliğini ve dilleri seçin. İçe aktarılan dosyalar özgün konumunda kalır."
          }
        }
      }
    },
