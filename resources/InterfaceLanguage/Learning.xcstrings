          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подсказки полужирным, курсивом или обоими стилями. Принятый текст сохраняет стиль поля."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
