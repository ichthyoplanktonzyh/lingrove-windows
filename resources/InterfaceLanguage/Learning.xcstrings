    "Swift wrapper around llama.cpp that exposes the inference API Lingrove links against." : {
      "comment" : "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غلاف Swift حول llama.cpp يوفّر واجهة الاستدلال التي يرتبط بها Lingrove."
          }
        },
        "de" : {
          "stringUnit" : {
