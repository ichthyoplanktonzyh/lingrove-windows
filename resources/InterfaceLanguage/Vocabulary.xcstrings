        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira uma resposta de revisão antes de enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед отправкой введите ответ для повторения."
          }
        },
