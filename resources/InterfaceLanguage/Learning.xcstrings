    "Add models from your LM Studio library (~/.lmstudio/models) to the picker above. Downloads still save to Lingrove's own folder." : {
      "comment" : "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف نماذج من مكتبة LM Studio لديك (~/.lmstudio/models) إلى القائمة أعلاه. تظل التنزيلات محفوظة في مجلد Lingrove الخاص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelle aus deiner LM-Studio-Bibliothek (~/.lmstudio/models) zum obigen Auswahlfeld hinzufügen. Downloads werden weiterhin in Lingroves eigenem Ordner gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade modelos de tu biblioteca de LM Studio (~/.lmstudio/models) al selector de arriba. Las descargas siguen guardándose en la carpeta propia de Lingrove."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des modèles depuis votre bibliothèque LM Studio (~/.lmstudio/models) au sélecteur ci-dessus. Les téléchargements sont toujours enregistrés dans le dossier de Lingrove."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी LM Studio लाइब्रेरी (~/.lmstudio/models) से ऊपर के चयनकर्ता में मॉडल जोड़ें। डाउनलोड Lingrove के अपने फ़ोल्डर में ही सेव होंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan model dari pustaka LM Studio Anda (~/.lmstudio/models) ke pemilih di atas. Unduhan tetap disimpan di folder Lingrove sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi al selettore i modelli dalla libreria di LM Studio (~/.lmstudio/models). I download vengono comunque salvati nella cartella di Lingrove."
