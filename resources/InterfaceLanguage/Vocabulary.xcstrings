    "Several Anki notes use this sense ID. Resolve duplicates in Anki.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم عدة ملاحظات Anki معرّف المعنى هذا. عالج التكرارات في Anki."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Anki-Notizen verwenden diese Bedeutungs-ID. Beheben Sie die Duplikate in Anki."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several Anki notes use this sense ID. Resolve duplicates in Anki."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varias notas de Anki usan este ID de sentido. Resuelve los duplicados en Anki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs notes Anki utilisent cet identifiant de sens. Résolvez les doublons dans Anki."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कई Anki नोट यह अर्थ ID इस्तेमाल करते हैं। Anki में डुप्लिकेट ठीक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa catatan Anki memakai ID makna ini. Selesaikan duplikat di Anki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più note Anki usano questo ID del significato. Risolvi i duplicati in Anki."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の Anki ノートがこの語義 ID を使用しています。Anki で重複を解消してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 Anki 노트가 이 의미 ID를 사용합니다. Anki에서 중복을 해결하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Várias notas do Anki usam este ID de sentido. Resolva as duplicatas no Anki."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько заметок Anki используют этот ID значения. Устраните дубликаты в Anki."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla Anki notu bu anlam kimliğini kullanıyor. Yinelenenleri Anki'de düzeltin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多条 Anki 笔记使用了此义项 ID。请在 Anki 中处理重复项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多則 Anki 筆記使用了此義項 ID。請在 Anki 中處理重複項。"
          }
        }
      }
    },
