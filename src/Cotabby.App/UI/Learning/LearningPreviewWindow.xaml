<Window x:Class="Cotabby.App.UI.Learning.LearningPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Like the Mac sentence card, this preview leaves keyboard focus in the source editor. -->
    <Border x:Name="Card" Width="430" Padding="16" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}">
        <StackPanel>
        <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="×" Width="28" Height="28" Focusable="False"
                            Padding="0" FontSize="18" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondary}" Click="OnCloseClick" />
                    <Button x:Name="ExplanationButton" DockPanel.Dock="Right" Content="✦" Width="28" Height="28" Focusable="False"
                            Padding="0" FontSize="16" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource AccentBrush}" Click="OnExplanationClick" Visibility="Collapsed" />
                    <TextBlock x:Name="TitleText" Text="Sentence translation" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock x:Name="StatusText" Text="Translating…" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,9" />
                <TextBlock x:Name="DirectionText" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,9" Visibility="Collapsed" />
                <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Margin="0,0,0,12" />

                <StackPanel x:Name="SourceSection" Margin="0,0,0,12">
                    <TextBlock Text="SOURCE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5" />
                    <Border Padding="10" CornerRadius="7" Background="{DynamicResource InputBg}">
                        <ScrollViewer MaxHeight="112" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="SourceText" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="13" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ResultSection" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="ResultLabel" Text="TRANSLATION" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5" />
                    <Border Padding="10" CornerRadius="7" Background="{DynamicResource InputBg}">
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ResultText" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="13" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource OrangeBrush}"
                           FontSize="12" Margin="0,0,0,12" Visibility="Collapsed" />

                <!-- Embedded Mac explanation: a complete older answer stays visible during refresh. -->
                <StackPanel x:Name="ExplanationSection" Margin="0,0,0,12" Visibility="Collapsed">
                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,0,0,10" />
                    <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ExplanationResult" Visibility="Collapsed">
                            <TextBlock x:Name="ExplanationMeaning" TextWrapping="Wrap" FontWeight="SemiBold"
                                       FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                            <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </ScrollViewer>
                    <ProgressBar x:Name="ExplanationProgress" Height="3" IsIndeterminate="True"
                                 Visibility="Collapsed" Margin="0,8,0,0" />
                    <TextBlock x:Name="ExplanationStatus" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
                <!-- Keep explicit Copy actions outside the bounded body, as on the Mac detail card. -->
                <WrapPanel x:Name="CopyActions" Margin="0,8,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="CopyStatus" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="RetryButton" Content="Retry" Padding="12,5" Margin="0,0,8,0" Focusable="False"
                            Background="{DynamicResource KeycapBg}" BorderBrush="{DynamicResource CardBorder}"
                            Foreground="{DynamicResource TextPrimary}" Click="OnRetryClick" Visibility="Collapsed" />
                    <Button x:Name="CancelButton" Content="Cancel" Padding="12,5" Focusable="False"
                            Background="{DynamicResource KeycapBg}" BorderBrush="{DynamicResource CardBorder}"
                            Foreground="{DynamicResource TextPrimary}" Click="OnCancelClick" />
                </StackPanel>
        </StackPanel>
    </Border>
</Window>
