<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\Shared\VocabularyDibFixture.cs" Link="Shared\VocabularyDibFixture.cs" />
    <Compile Include="..\Shared\LearningLexicalCorpus.cs" Link="Shared\LearningLexicalCorpus.cs" />
    <Compile Include="..\Shared\LearningExplanationCaptureCorpus.cs" Link="Shared\LearningExplanationCaptureCorpus.cs" />
    <None Include="..\..\fixtures\parity\learning-explanation-capture-v1.json" Link="fixtures\parity\learning-explanation-capture-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\audio\generated-speech-tone.mp3" Link="fixtures\generated-speech-tone.mp3" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\parity\learning-lexical-v1.json" Link="fixtures\parity\learning-lexical-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\resources\LearningLexicon\learning-expressions*"
          Link="Resources\LearningLexicon\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exercise the real persisted settings without starting the WPF application or touching
         the user's settings directory. This file depends only on Core and Inference contracts. -->
    <Compile Include="..\..\src\Cotabby.App\Settings\AppSettings.cs" Link="AppSettings\AppSettings.cs" />
    <Compile Include="..\..\src\Cotabby.App\Settings\AppSettings.AutocompleteStreaming.cs" Link="AppSettings\AppSettings.AutocompleteStreaming.cs" />
    <Compile Include="..\..\src\Cotabby.App\Settings\AppSettings.ModelAssignments.cs" Link="AppSettings\AppSettings.ModelAssignments.cs" />
    <Compile Include="..\..\src\Cotabby.App\Settings\AppSettings.Review.cs" Link="Production\AppSettings.Review.cs" />
    <Compile Include="..\..\src\Cotabby.App\Settings\AppSettings.Speech.cs" Link="Production\AppSettings.Speech.cs" />
    <Compile Include="..\..\src\Cotabby.App\Settings\AppSettings.Metrics.cs" Link="Production\AppSettings.Metrics.cs" />
    <Compile Include="..\..\src\Cotabby.App\Settings\AppSettings.Onboarding.cs" Link="Production\AppSettings.Onboarding.cs" />
    <Compile Include="..\..\src\Cotabby.App\Settings\AppSettings.Vocabulary.cs" Link="AppSettings\AppSettings.Vocabulary.cs" />
    <Compile Include="..\..\src\Cotabby.App\Settings\AppSettings.Explanation.cs" Link="AppSettings\AppSettings.Explanation.cs" />
    <Compile Include="..\..\src\Cotabby.App\Settings\AppSettings.ExplanationEndpoint.cs" Link="AppSettings\AppSettings.ExplanationEndpoint.cs" />
    <Compile Include="..\..\src\Cotabby.App\Learning\LearningModelCatalogManager.cs" Link="AppLearning\LearningModelCatalogManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cotabby.Core\Cotabby.Core.csproj" />
    <ProjectReference Include="..\..\src\Cotabby.Inference\Cotabby.Inference.csproj" />
    <ProjectReference Include="..\..\src\Cotabby.Win32\Cotabby.Win32.csproj" />
    <ProjectReference Include="..\..\src\Cotabby.Cli.Launcher\Cotabby.Cli.Launcher.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Cotabby.Cli.TestHelper\Cotabby.Cli.TestHelper.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\Cotabby.Cli.Launcher\bin\$(Configuration)\$(TargetFramework)\win-x64\lingrove-launcher.exe;..\..\src\Cotabby.Cli.Launcher\bin\$(Configuration)\$(TargetFramework)\win-x64\lingrove-launcher.dll;..\..\src\Cotabby.Cli.Launcher\bin\$(Configuration)\$(TargetFramework)\win-x64\lingrove-launcher.deps.json;..\..\src\Cotabby.Cli.Launcher\bin\$(Configuration)\$(TargetFramework)\win-x64\lingrove-launcher.runtimeconfig.json" Link="cli-launcher\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Cotabby.Cli.TestHelper\bin\$(Configuration)\$(TargetFramework)\win-x64\lingrove.exe;..\Cotabby.Cli.TestHelper\bin\$(Configuration)\$(TargetFramework)\win-x64\lingrove.dll;..\Cotabby.Cli.TestHelper\bin\$(Configuration)\$(TargetFramework)\win-x64\lingrove.deps.json;..\Cotabby.Cli.TestHelper\bin\$(Configuration)\$(TargetFramework)\win-x64\lingrove.runtimeconfig.json" Link="cli-helper\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\SpeechRuntimeFixture.cs" Link="Shared\SpeechRuntimeFixture.cs" />
    <Compile Include="..\Shared\SpeechRuntimeCases.cs" Link="Shared\SpeechRuntimeCases.cs" />
    <None Include="..\..\fixtures\parity\speech-runtime-v1.json" Link="fixtures\speech-runtime-v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="..\Shared\SpeechTestHelper.targets" />
</Project>
