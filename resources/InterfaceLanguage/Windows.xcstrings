    "Speech for review audio: unavailable. Configure speech before preparing audio.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech for review audio: unavailable. Configure speech before preparing audio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复习音频语音服务不可用，请先配置语音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複習音訊語音服務無法使用，請先設定語音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復習用音声は利用できません。音声を準備する前に音声設定を行ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복습 오디오 음성 서비스를 사용할 수 없습니다. 오디오를 준비하기 전에 음성을 설정하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix de révision est indisponible. Configurez la voix avant de préparer l’audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachausgabe für die Wiederholung ist nicht verfügbar. Konfigurieren Sie sie vor der Audioerstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz para repaso no está disponible. Configúrala antes de preparar audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz para revisão está indisponível. Configure a voz antes de preparar o áudio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voce per il ripasso non disponibile. Configurala prima di preparare l’audio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Речь для повторения недоступна. Настройте её перед подготовкой аудио."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة النطق للمراجعة غير متاحة. اضبط النطق قبل إعداد الصوت."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समीक्षा ऑडियो के लिए वाणी उपलब्ध नहीं है। ऑडियो तैयार करने से पहले वाणी सेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara ulasan tidak tersedia. Atur suara sebelum menyiapkan audio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar için konuşma kullanılamıyor. Ses hazırlamadan önce konuşmayı yapılandırın."
          }
        }
      }
    },
    "Review audio is unavailable. Remove any requested audio before sending.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review audio is unavailable. Remove any requested audio before sending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复习音频不可用，请移除音频请求后再发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複習音訊無法使用，請移除音訊要求後再傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復習用音声は利用できません。送信前に音声の要求を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복습 오디오를 사용할 수 없습니다. 보내기 전에 오디오 요청을 제거하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio de révision est indisponible. Retirez les demandes audio avant l’envoi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio für die Wiederholung ist nicht verfügbar. Entfernen Sie Audioanforderungen vor dem Senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio de repaso no está disponible. Quita las solicitudes de audio antes de enviar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio de revisão está indisponível. Remova as solicitações de áudio antes de enviar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio di ripasso non disponibile. Rimuovi le richieste audio prima dell’invio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио для повторения недоступно. Уберите запросы аудио перед отправкой."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوت المراجعة غير متاح. أزل طلبات الصوت قبل الإرسال."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समीक्षा ऑडियो उपलब्ध नहीं है। भेजने से पहले ऑडियो अनुरोध हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio ulasan tidak tersedia. Hapus permintaan audio sebelum mengirim."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar sesi kullanılamıyor. Göndermeden önce ses isteklerini kaldırın."
          }
        }
      }
    },
    "Speech is unavailable. Remove this audio slot before sending.": {
      "localizations": {
        "en": {
