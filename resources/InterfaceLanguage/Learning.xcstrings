    "Writes a valid preview back to its saved sentence or selection. Never sends the message." : {
      "comment" : "Explains the scoped replacement command.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكتب المعاينة الصالحة في الجملة أو التحديد المحفوظ. لا يرسل الرسالة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt eine gültige Vorschau in den gespeicherten Satz oder die Auswahl zurück. Sendet keine Nachricht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes a valid preview back to its saved sentence or selection. Never sends the message."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe la vista previa válida en la frase o selección guardada. Nunca envía el mensaje."
          }
        },
        "fr" : {
          "stringUnit" : {
