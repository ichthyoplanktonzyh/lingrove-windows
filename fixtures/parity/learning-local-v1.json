  "delimiterCases": [
    {
      "id": "delimiters-hymt",
      "macTest": "LearningLocalPrompt.delimiters (source-derived template matrix)",
      "template": "hyMT",
      "expectedPrefix": "<｜hy_begin▁of▁sentence｜><｜hy_User｜>",
      "expectedSuffix": "<｜hy_Assistant｜>"
    },
    {
      "id": "delimiters-hymt7",
      "macTest": "LearningLocalPromptTests.hySizesWithTheSameArchitectureResolveDifferentTokenizers",
      "template": "hyMT7",
      "expectedPrefix": "<|startoftext|>",
      "expectedSuffix": "<|extra_0|>"
    },
    {
      "id": "delimiters-chatml",
      "macTest": "LearningLocalPrompt.delimiters (source-derived template matrix)",
      "template": "chatML",
      "expectedPrefix": "<|im_start|>user\n",
      "expectedSuffix": "<|im_end|>\n<|im_start|>assistant\n"
    },
    {
      "id": "delimiters-qwen3-keeps-empty-thought-block",
      "macTest": "LearningLocalPromptTests.trustedTemplateAndUntrustedPayloadRemainSeparate",
      "template": "qwen3",
      "expectedPrefix": "<|im_start|>user\n",
      "expectedSuffix": "<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n"
    },
    {
      "id": "delimiters-gemma4",
      "macTest": "LearningLocalPrompt.delimiters (source-derived template matrix)",
      "template": "gemma4",
      "expectedPrefix": "<bos><|turn>user\n",
      "expectedSuffix": "<turn|>\n<|turn>model\n"
    },
    {
      "id": "delimiters-gemma4-large",
      "macTest": "LearningLocalPrompt.delimiters (source-derived template matrix)",
      "template": "gemma4Large",
      "expectedPrefix": "<bos><|turn>user\n",
      "expectedSuffix": "<turn|>\n<|turn>model\n<|channel>thought\n<channel|>"
    },
    {
      "id": "delimiters-gemma3",
      "macTest": "LearningLocalPrompt.delimiters (source-derived template matrix)",
      "template": "gemma3",
      "expectedPrefix": "<bos><start_of_turn>user\n",
      "expectedSuffix": "<end_of_turn>\n<start_of_turn>model\n"
    },
    {
      "id": "delimiters-translategemma",
      "macTest": "LearningLocalPromptTests.renamedGemmaFilesKeepTheirTaskIdentityFromMetadata",
      "template": "translateGemma",
      "expectedPrefix": "<bos><start_of_turn>user\n",
      "expectedSuffix": "<end_of_turn>\n<start_of_turn>model\n"
    },
    {
      "id": "delimiters-llama3",
      "macTest": "LearningLocalPrompt.delimiters (source-derived template matrix)",
      "template": "llama3",
      "expectedPrefix": "<|begin_of_text|><|start_header_id|>user<|end_header_id|>\n\n",
      "expectedSuffix": "<|eot_id|><|start_header_id|>assistant<|end_header_id|>\n\n"
    },
    {
      "id": "delimiters-automatic-is-not-a-renderable-template",
      "macTest": "LearningLocalPromptTests.trustedTemplateAndUntrustedPayloadRemainSeparate",
      "template": "automatic",
      "expectedFailure": true
    }
  ],
