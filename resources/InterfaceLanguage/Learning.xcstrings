          }
        }
      }
    },
    "Some chunk alignments could not be located reliably; confirmed matches are kept." : {
      "comment" : "Status when uncertain alignments are omitted while verified chunk alignments remain visible.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحديد مواضع بعض مطابقات العبارات بثقة؛ وتم الإبقاء على المطابقات المؤكدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Phrasenzuordnungen ließen sich nicht zuverlässig im Text finden; bestätigte Zuordnungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron localizar algunas correspondencias entre frases de forma fiable; se conservan las confirmadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines correspondances d’expressions n’ont pas pu être localisées de manière fiable ; les correspondances confirmées sont conservées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ वाक्यांशों का भरोसेमंद ढंग से मिलान नहीं हो सका; पुष्ट मिलान रखे गए हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa kecocokan frasa tidak dapat ditemukan dengan andal; kecocokan yang terkonfirmasi tetap ditampilkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile individuare con affidabilità alcune corrispondenze tra frasi; vengono mantenute quelle confermate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のフレーズ対応箇所を確実に特定できなかったため、確認できた箇所だけを表示しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 구문 대응을 안정적으로 찾지 못해 확인된 대응만 유지했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível localizar algumas correspondências entre frases com segurança; as correspondências confirmadas foram mantidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось надёжно определить некоторые соответствия фраз; подтверждённые соответствия сохранены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı ifade eşleşmelerinin yeri güvenilir biçimde belirlenemedi; doğrulanmış eşleşmeler korundu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分语块对齐无法可靠定位；已保留能够确认的对齐项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分語塊對齊無法可靠定位；已保留可確認的對應內容。"
          }
        }
      }
    },
