      "expectedSuppression": null
    },
    {
      "id": "emoji-prefix-echo-is-removed-as-a-whole",
      "macTest": "SuggestionTextNormalizerTests.test_normalize_removesVisiblePrefixEcho",
      "prompt": "PROMPT",
      "prefixText": "I love 👩🏽‍💻",
      "prefixUtf16Length": 14,
      "precedingText": "I love 👩🏽‍💻",
      "raw": "I love 👩🏽‍💻 coding",
      "isMultiLineEnabled": false,
      "expectedText": " coding",
      "expectedSuppression": null
    },
    {
      "id": "single-line-mode-keeps-first-line-after-crlf",
      "macTest": "SuggestionTextNormalizerTests.test_normalize_singleLineKeepsOnlyTheFirstContentLine",
      "prompt": "PROMPT",
      "prefixText": "Hello",
      "precedingText": "Hello",
      "raw": "next\r\nsecond",
      "isMultiLineEnabled": false,
      "expectedText": "next",
      "expectedSuppression": null
    },
    {
      "id": "repeated-trailing-text-is-suppressed",
      "macTest": "SuggestionTextNormalizerTests.test_normalizeDetailed_attributesEverySuppression",
      "prompt": "PROMPT",
      "prefixText": "Hello",
      "precedingText": "Hello",
      "trailingText": " existing suffix",
      "raw": " existing suffix and extra generated text",
      "isMultiLineEnabled": false,
      "expectedText": "",
      "expectedSuppression": "DuplicatesTrailingText"
    },
    {
      "id": "preceding-tail-echo-is-suppressed-with-reason",
      "macTest": "SuggestionTextNormalizerTests.test_normalizeDetailed_attributesEverySuppression",
      "prompt": "PROMPT",
      "prefixText": "hello world",
      "precedingText": "hello world",
      "raw": "world",
      "isMultiLineEnabled": false,
      "expectedText": "",
      "expectedSuppression": "EchoesPrecedingText"
    }
  ]
