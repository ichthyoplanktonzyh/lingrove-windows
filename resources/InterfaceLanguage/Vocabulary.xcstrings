    "Could not connect to Anki. Open Anki with AnkiConnect enabled.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الاتصال بـ Anki. افتح Anki مع تفعيل AnkiConnect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung zu Anki. Öffnen Sie Anki mit aktiviertem AnkiConnect."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not connect to Anki. Open Anki with AnkiConnect enabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con Anki. Abre Anki con AnkiConnect activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion à Anki impossible. Ouvrez Anki avec AnkiConnect activé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki से कनेक्ट नहीं हो सका। AnkiConnect सक्षम करके Anki खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat terhubung ke Anki. Buka Anki dengan AnkiConnect aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile connettersi ad Anki. Apri Anki con AnkiConnect attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki に接続できません。AnkiConnect を有効にして Anki を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki에 연결할 수 없습니다. AnkiConnect를 활성화하고 Anki를 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível conectar ao Anki. Abra o Anki com AnkiConnect ativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться к Anki. Откройте Anki с включённым AnkiConnect."
          }
        },
        "tr": {
