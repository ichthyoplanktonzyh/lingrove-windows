    "The separate endpoint credential is not read or used while Local is selected.": {
      "comment": "Windows authored interface copy; exact source, model, path and provider values remain arguments.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The separate endpoint credential is not read or used while Local is selected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“本地”时，不会读取或使用独立端点的凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「本機」時，不會讀取或使用獨立端點的憑證。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルを選択している間、別のエンドポイント認証情報は読み取りも使用もしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 선택 중에는 별도 엔드포인트 자격 증명을 읽거나 사용하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode local, les identifiants du point de terminaison distinct ne sont ni lus ni utilisés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei ausgewähltem Lokalmodus werden die separaten Endpunkt-Zugangsdaten weder gelesen noch verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al seleccionar Local, no se leen ni usan las credenciales del servidor independiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com Local selecionado, a credencial do endpoint separado não é lida nem usada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Locale selezionato, le credenziali dell’endpoint separato non vengono lette né usate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При выборе локального режима данные отдельного сервера не читаются и не используются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند اختيار المحلي، لا تُقرأ بيانات اعتماد نقطة النهاية المنفصلة ولا تُستخدم."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय चुने रहने पर अलग एंडपॉइंट के क्रेडेंशियल पढ़े या उपयोग नहीं किए जाते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Lokal dipilih, kredensial endpoint terpisah tidak dibaca atau dipakai."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel seçiliyken ayrı uç nokta kimlik bilgileri okunmaz veya kullanılmaz."
          }
        }
      }
    },
