    "Same-quantity conversions across length, mass, temperature, and volume. Fully offline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same-quantity conversions across length, mass, temperature, and volume. Fully offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长度、质量、温度和体积等同类量之间的换算，完全离线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長度、質量、溫度與體積等同類量之間的換算，完全離線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長さ、質量、温度、体積の同種の量を変換します。完全オフラインです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길이, 질량, 온도, 부피의 같은 종류 단위를 변환합니다. 완전히 오프라인으로 작동합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversions de longueur, masse, température et volume entre unités de même nature. Entièrement hors ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umrechnung gleicher Größen für Länge, Masse, Temperatur und Volumen. Vollständig offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversiones de longitud, masa, temperatura y volumen entre unidades del mismo tipo. Totalmente sin conexión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversões de comprimento, massa, temperatura e volume entre unidades da mesma grandeza. Totalmente off-line."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversioni di lunghezza, massa, temperatura e volume tra unità della stessa grandezza. Completamente offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод единиц длины, массы, температуры и объёма в рамках одной величины. Полностью автономно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحويل وحدات الطول والكتلة ودرجة الحرارة والحجم للكميات المتشابهة. دون اتصال بالكامل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबाई, द्रव्यमान, तापमान और आयतन की समान मात्राओं के बीच रूपांतरण। पूरी तरह ऑफ़लाइन।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konversi satuan sejenis untuk panjang, massa, suhu, dan volume. Sepenuhnya luring."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzunluk, kütle, sıcaklık ve hacim için aynı tür birimler arasında dönüşüm. Tamamen çevrimdışı."
          }
        }
      }
    },
