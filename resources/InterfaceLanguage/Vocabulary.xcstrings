    "A gap card requires valid expression positions in an example.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب بطاقة الفراغات مواضع تعبير صالحة في مثال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Lückenkarte benötigt gültige Ausdruckspositionen in einem Beispiel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gap card requires valid expression positions in an example."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta de huecos necesita posiciones válidas de la expresión en un ejemplo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte à trous nécessite des positions valides dans un exemple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिक्त स्थान कार्ड के लिए उदाहरण में अभिव्यक्ति के मान्य स्थान आवश्यक हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu isian memerlukan posisi ungkapan yang valid dalam contoh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scheda con lacune richiede posizioni valide dell’espressione in un esempio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穴埋めカードには例文内の有効な表現位置が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈칸 카드에는 예문 내 유효한 표현 위치가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão de lacunas precisa de posições válidas da expressão em um exemplo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для карточки с пропусками нужны корректные позиции выражения в примере."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluk kartı için örnekte geçerli ifade konumları gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填空卡需要例句中有效的表达位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填空卡需要例句中有效的表達位置。"
          }
        }
      }
    },
    "Add a review answer before sending.": {
      "extractionState": "manual",
      "localizations": {
