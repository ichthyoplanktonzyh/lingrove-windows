          "stringUnit" : {
            "state" : "translated",
            "value" : "Il simbolo di attivazione non deve iniziare con : o /, che aprono emoji e macro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トリガーは : または / 以外で始めてください。これらは絵文字とマクロを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리거는 : 또는 /로 시작할 수 없습니다. 이 기호는 이모티콘과 매크로를 엽니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O gatilho não pode começar com : ou /; esses símbolos abrem emojis e macros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Триггер не должен начинаться с : или / — они открывают эмодзи и макросы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetikleyici : veya / ile başlamamalıdır; bunlar emoji ve makroları açar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触发符号不能以 : 或 / 开头；它们用于打开表情与宏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸發符號不能以 : 或 / 開頭；它們用於開啟表情與巨集。"
          }
        }
      }
    },
