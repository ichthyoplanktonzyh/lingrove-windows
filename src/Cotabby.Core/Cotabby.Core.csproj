<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Cotabby.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Emoji\emoji.json" />
    <EmbeddedResource Include="Resources\Foundation\editor-text-data-v1.json" />
    <EmbeddedResource Include="Vocabulary/Resources/VocabularyClassificationCatalog.json"
                      LogicalName="Cotabby.Core.Vocabulary.Resources.VocabularyClassificationCatalog.json" />
    <Content Include="Resources\Foundation\NOTICE.md;Resources\Foundation\LICENSE.*.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\Spelling\**" Exclude="Resources\Spelling\.gitattributes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
