          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki ha rifiutato la richiesta. Controlla chiave, campi e profilo attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki がリクエストを拒否しました。キー、フィールド、プロファイルを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki가 요청을 거부했습니다. 키, 필드 및 현재 프로필을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Anki rejeitou a solicitação. Confira a chave, os campos e o perfil ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki отклонил запрос. Проверьте ключ, поля и активный профиль."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki isteği reddetti. Anahtarı, alanları ve etkin profili kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki 拒绝了请求。请检查密钥、字段和当前档案。"
