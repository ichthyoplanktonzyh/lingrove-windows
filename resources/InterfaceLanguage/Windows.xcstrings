          "stringUnit": {
            "state": "translated",
            "value": "この辞書設定を保存できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사전 설정을 저장하지 못했습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer ce réglage de dictionnaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wörterbucheinstellung konnte nicht gespeichert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar este ajuste del diccionario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar esta configuração do dicionário."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare questa impostazione del dizionario."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить настройку словаря."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ إعداد القاموس هذا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह शब्दकोश सेटिंग सहेजी नहीं जा सकी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyimpan pengaturan kamus ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sözlük ayarı kaydedilemedi."
          }
        }
      }
    },
    "Enter a name and valid HTTPS URL containing one {query}.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a name and valid HTTPS URL containing one {query}."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入名称和有效的 HTTPS 地址，地址须包含一个 {query}。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入名稱和有效的 HTTPS 網址，網址須包含一個 {query}。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前と、{query}を1つ含む有効なHTTPS URLを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름과 {query} 하나가 포함된 유효한 HTTPS URL을 입력하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom et une URL HTTPS valide contenant une seule occurrence de {query}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen Namen und eine gültige HTTPS-URL mit genau einem {query} ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un nombre y una URL HTTPS válida que contenga un solo {query}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um nome e uma URL HTTPS válida contendo um único {query}."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un nome e un URL HTTPS valido contenente un solo {query}."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите имя и действительный HTTPS-адрес с одним {query}."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل اسمًا ورابط HTTPS صالحًا يحتوي على {query} مرة واحدة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम और एक {query} वाला मान्य HTTPS URL दर्ज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan nama dan URL HTTPS valid yang memuat satu {query}."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ad ve bir adet {query} içeren geçerli bir HTTPS URL’si girin."
          }
        }
      }
    },
    "Select a region to read · Esc or right-click to cancel\nWindows OCR runs on this device; screen pixels are not sent to a model.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a region to read · Esc or right-click to cancel\nWindows OCR runs on this device; screen pixels are not sent to a model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "框选要阅读的区域 · 按 Esc 或右键取消\nWindows OCR 在本机运行，不向模型发送屏幕像素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "框選要閱讀的區域 · 按 Esc 或按右鍵取消\nWindows OCR 在本機執行，不會將螢幕像素傳送給模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取る領域を選択 · Escまたは右クリックでキャンセル\nWindows OCRはこのデバイスで実行され、画面の画像はモデルに送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽을 영역 선택 · Esc 또는 오른쪽 클릭으로 취소\nWindows OCR은 이 장치에서 실행되며 화면 픽셀은 모델로 전송되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une zone à lire · Échap ou clic droit pour annuler\nWindows OCR s’exécute sur cet appareil ; les pixels ne sont pas envoyés à un modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereich zum Lesen auswählen · Esc oder Rechtsklick zum Abbrechen\nWindows OCR läuft auf diesem Gerät; Bildschirmpixel werden nicht an ein Modell gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una región para leer · Esc o clic derecho para cancelar\nWindows OCR se ejecuta en este dispositivo; los píxeles de pantalla no se envían a un modelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma região para ler · Esc ou clique direito para cancelar\nO Windows OCR é executado neste dispositivo; os pixels da tela não são enviados a um modelo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un’area da leggere · Esc o clic destro per annullare\nWindows OCR viene eseguito sul dispositivo; i pixel dello schermo non vengono inviati a un modello."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите область для чтения · Esc или правая кнопка для отмены\nWindows OCR работает на этом устройстве; пиксели экрана не передаются модели."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد منطقة للقراءة · Esc أو زر الفأرة الأيمن للإلغاء\nتعمل ميزة Windows OCR على هذا الجهاز؛ ولا تُرسل وحدات بكسل الشاشة إلى أي نموذج."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ने के लिए क्षेत्र चुनें · रद्द करने के लिए Esc या दायाँ क्लिक\nWindows OCR इसी डिवाइस पर चलता है; स्क्रीन पिक्सेल किसी मॉडल को नहीं भेजे जाते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih area untuk dibaca · Esc atau klik kanan untuk batal\nWindows OCR berjalan di perangkat ini; piksel layar tidak dikirim ke model."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunacak bölgeyi seçin · İptal için Esc veya sağ tık\nWindows OCR bu cihazda çalışır; ekran pikselleri bir modele gönderilmez."
          }
        }
      }
    },
    "Use Lingrove in a compatible editor. If that editor runs as an administrator, Lingrove may need the same privilege level.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Lingrove in a compatible editor. If that editor runs as an administrator, Lingrove may need the same privilege level."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在兼容的编辑器中使用 Lingrove。若编辑器以管理员身份运行，Lingrove 可能也需要相同权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在相容的編輯器中使用 Lingrove。若編輯器以系統管理員身分執行，Lingrove 可能也需要相同權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応するエディターでLingroveを使用してください。エディターが管理者として実行されている場合、Lingroveにも同じ権限が必要なことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호환되는 편집기에서 Lingrove를 사용하세요. 편집기가 관리자 권한으로 실행된다면 Lingrove에도 같은 권한이 필요할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Lingrove dans un éditeur compatible. Si l’éditeur s’exécute en tant qu’administrateur, Lingrove peut nécessiter le même niveau de privilèges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Lingrove in einem kompatiblen Editor. Läuft dieser als Administrator, benötigt Lingrove möglicherweise dieselben Berechtigungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Lingrove en un editor compatible. Si el editor se ejecuta como administrador, Lingrove podría necesitar el mismo nivel de permisos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Lingrove em um editor compatível. Se ele for executado como administrador, Lingrove poderá precisar do mesmo nível de privilégio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Lingrove in un editor compatibile. Se l’editor viene eseguito come amministratore, Lingrove potrebbe richiedere lo stesso livello di privilegi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте Lingrove в совместимом редакторе. Если редактор запущен от администратора, Lingrove может потребоваться тот же уровень прав."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم Lingrove في محرر متوافق. إذا كان المحرر يعمل بصلاحيات المسؤول، فقد يحتاج Lingrove إلى مستوى الصلاحيات نفسه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove को संगत संपादक में उपयोग करें। यदि संपादक प्रशासक के रूप में चलता है, तो Lingrove को भी वही अधिकार चाहिए हो सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan Lingrove di editor yang kompatibel. Jika editor berjalan sebagai administrator, Lingrove mungkin memerlukan hak yang sama."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove’u uyumlu bir düzenleyicide kullanın. Düzenleyici yönetici olarak çalışıyorsa Lingrove aynı ayrıcalık düzeyini gerektirebilir."
          }
        }
      }
    },
    "Text stays local unless you explicitly configure and use an endpoint.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text stays local unless you explicitly configure and use an endpoint."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本保留在本地；只有明确配置并使用服务端点时才会发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字保留在本機；只有明確設定並使用服務端點時才會傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明示的にエンドポイントを設定して使用しない限り、テキストはローカルに留まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔드포인트를 명시적으로 설정하고 사용하지 않는 한 텍스트는 로컬에 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte reste local sauf si vous configurez et utilisez explicitement un service distant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text bleibt lokal, sofern Sie nicht ausdrücklich einen Endpunkt konfigurieren und verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto permanece en tu dispositivo salvo que configures y uses explícitamente un punto de conexión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto permanece local, a menos que você configure e use explicitamente um endpoint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo rimane in locale a meno che tu non configuri e utilizzi esplicitamente un endpoint."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст остаётся локальным, если вы явно не настроите и не используете сервер."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى النص محليًا ما لم تضبط نقطة نهاية وتستخدمها صراحةً."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप स्पष्ट रूप से एंडपॉइंट सेट और उपयोग नहीं करते, पाठ स्थानीय रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks tetap lokal kecuali Anda secara eksplisit mengatur dan memakai endpoint."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıkça bir uç nokta yapılandırıp kullanmadığınız sürece metin yerel kalır."
          }
        }
      }
    },
    "The local speech helper is not available in this build.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local speech helper is not available in this build."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建中暂无法使用本地语音辅助程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此組建目前無法使用本機語音輔助程式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドではローカル音声ヘルパーを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에서는 로컬 음성 도우미를 사용할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant vocal local est indisponible dans cette version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Sprachhelfer ist in diesem Build nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El componente de voz local no está disponible en esta compilación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O auxiliar de voz local está indisponível nesta compilação."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il componente vocale locale non è disponibile in questa build."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальный речевой помощник недоступен в этой сборке."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساعد النطق المحلي غير متاح في هذا الإصدار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बिल्ड में स्थानीय वाणी सहायक उपलब्ध नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembantu suara lokal tidak tersedia dalam build ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel konuşma yardımcısı bu derlemede kullanılamıyor."
          }
        }
      }
    },
    "Models download only when you choose setup. Translation and expression assistance use their own task settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Models download only when you choose setup. Translation and expression assistance use their own task settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在选择设置方案后才会下载模型。翻译与表达式辅助分别使用自己的任务设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有選擇設定方案後才會下載模型。翻譯與表達式輔助分別使用各自的工作設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルはセットアップを選択したときだけダウンロードされます。翻訳と表現アシストは、それぞれのタスク設定を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 선택할 때만 모델을 다운로드합니다. 번역과 표현 지원은 각 작업의 설정을 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles sont téléchargés uniquement si vous choisissez la configuration. La traduction et l’aide à l’expression utilisent leurs propres réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle werden nur heruntergeladen, wenn Sie die Einrichtung auswählen. Übersetzung und Formulierungshilfe verwenden ihre eigenen Aufgabeneinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos solo se descargan cuando eliges configurarlos. La traducción y la ayuda de expresión usan sus propios ajustes de tarea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos só são baixados quando você escolhe a configuração. Tradução e assistência de expressão usam suas próprias configurações de tarefa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli vengono scaricati solo se scegli la configurazione. Traduzione e assistenza espressiva usano le proprie impostazioni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели загружаются только при выборе настройки. Перевод и помощь с выражениями используют отдельные настройки задач."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنزَّل النماذج فقط عند اختيار الإعداد. تستخدم الترجمة ومساعدة التعبير إعدادات منفصلة لكل مهمة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल तभी डाउनलोड होते हैं जब आप सेटअप चुनते हैं। अनुवाद और अभिव्यक्ति सहायता अपनी अलग कार्य सेटिंग उपयोग करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model hanya diunduh saat Anda memilih penyiapan. Terjemahan dan bantuan ungkapan memakai pengaturan tugasnya sendiri."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeller yalnızca kurulumu seçtiğinizde indirilir. Çeviri ve ifade yardımı kendi görev ayarlarını kullanır."
          }
        }
      }
    },
