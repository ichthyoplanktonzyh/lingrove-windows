          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "框选要阅读的区域 · 按 Esc 或右键取消\nWindows OCR 在本机运行，不向模型发送屏幕像素。"
          }
        },
