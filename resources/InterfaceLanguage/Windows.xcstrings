    "No per-app shortcuts. Lingrove uses the global accept keys everywhere.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No per-app shortcuts. Lingrove uses the global accept keys everywhere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未设置应用专用快捷键，所有应用使用全局接受快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未設定應用程式專用快速鍵，所有應用程式均使用全域接受快速鍵。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ別のショートカットはありません。Lingroveはすべてのアプリで共通の採用キーを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱별 단축키가 없습니다. Lingrove는 모든 앱에서 공통 수락 키를 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun raccourci par application. Lingrove utilise les touches d’acceptation globales partout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine appbezogenen Tastenkürzel. Lingrove verwendet überall die globalen Übernahmetasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay atajos por aplicación. Lingrove usa las teclas globales de aceptación en todas ellas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem atalhos por aplicativo. Lingrove usa as teclas globais de aceitação em todos eles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna scorciatoia per app. Lingrove usa ovunque i tasti globali di accettazione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сочетаний для отдельных приложений. Lingrove использует общие клавиши принятия."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد اختصارات خاصة بالتطبيقات. يستخدم Lingrove مفاتيح القبول العامة في كل مكان."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक ऐप के लिए शॉर्टकट नहीं हैं। Lingrove हर जगह सामान्य स्वीकार कुंजियाँ उपयोग करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pintasan per aplikasi. Lingrove memakai tombol penerimaan global di semua aplikasi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamaya özel kısayol yok. Lingrove her yerde genel kabul tuşlarını kullanır."
          }
        }
      }
    },
