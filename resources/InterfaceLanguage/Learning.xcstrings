{
  "sourceLanguage" : "en",
  "strings" : {
    "Your existing endpoints will receive requests for enabled features." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتلقى الخدمات التي أعددتها طلبات الميزات المفعّلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre bereits eingerichteten Endpunkte erhalten Anfragen der aktivierten Funktionen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your existing endpoints will receive requests for enabled features."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servicios que ya has configurado recibirán las solicitudes de las funciones activadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos services déjà configurés recevront les requêtes des fonctionnalités activées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्रिय सुविधाओं के अनुरोध आपके पहले से कॉन्फ़िगर किए गए सर्वरों पर भेजे जाएँगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layanan yang sudah Anda atur akan menerima permintaan dari fitur yang diaktifkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I servizi già configurati riceveranno le richieste delle funzionalità attivate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存の接続先に、有効な機能のリクエストが送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화된 기능의 요청이 기존에 설정한 서버로 전송됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus serviços já configurados receberão solicitações dos recursos ativados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запросы включённых функций будут отправляться на уже настроенные серверы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önceden yapılandırdığınız hizmetler, etkin özelliklerin isteklerini alır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已配置的服务将接收已启用功能的请求。"
          }
