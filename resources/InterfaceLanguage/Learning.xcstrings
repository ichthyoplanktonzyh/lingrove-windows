        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative ou desative o Lingrove globalmente sem abrir a barra de menus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глобально включать или выключать Lingrove, не открывая строку меню."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü çubuğunu açmadan Lingrove'yi genel olarak açın veya kapatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需打开菜单栏，即可全局开启或关闭拾语。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不必開啟選單列選單，即可全域開啟或關閉拾語。"
          }
        }
      }
    },
    "Turn suggestions off in this app." : {
      "localizations" : {
        "ar" : {
