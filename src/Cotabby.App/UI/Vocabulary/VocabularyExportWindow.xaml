<Window x:Class="Cotabby.App.UI.Vocabulary.VocabularyExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export vocabulary" Width="720" Height="760" MinWidth="620" MinHeight="620"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Theme.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,14" /><Setter Property="Padding" Value="12" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
            <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="18">
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="BusyText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" IsCancel="True" Click="OnCancel" Padding="16,6" Margin="0,0,8,0" />
            <Button x:Name="ExportButton" Grid.Column="2" Content="Export…" IsDefault="True" Click="OnExport" Padding="16,6" IsEnabled="False" />
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel x:Name="FormContent">
                    <GroupBox Header="Export scope">
                        <StackPanel>
                            <ComboBox x:Name="ScopeChoice" Style="{StaticResource Combo}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnOptionsChanged" AutomationProperties.Name="Range">
                                <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="IsEnabled" Value="{Binding IsEnabled}" /></Style></ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <TextBlock x:Name="CountsText" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Export format">
                        <StackPanel>
                            <ComboBox x:Name="FormatChoice" Style="{StaticResource Combo}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnOptionsChanged" AutomationProperties.Name="Format" />
                            <StackPanel x:Name="TextStyleRow" Margin="0,10,0,0">
                                <TextBlock Text="Text layout" Margin="0,0,0,5" />
                                <ComboBox x:Name="TextStyleChoice" Style="{StaticResource Combo}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnOptionsChanged" AutomationProperties.Name="Text layout" />
                            </StackPanel>
                            <CheckBox x:Name="SpreadsheetChoice" Content="Spreadsheet compatibility" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" ToolTip="Adds a UTF-8 signature and protects cells that start with formula symbols." />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="ContentOptions" Header="Export content">
                        <StackPanel>
                            <CheckBox x:Name="MeaningsChoice" Content="Meanings" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" />
                            <CheckBox x:Name="ExamplesChoice" Content="Examples and translations" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" />
                            <CheckBox x:Name="NotesChoice" Content="Notes and tags" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" />
                            <CheckBox x:Name="ExplanationChoice" Content="AI explanation" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" />
                            <CheckBox x:Name="ContentChoice" Content="Supplemental content" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" />
                            <CheckBox x:Name="ImagesChoice" Content="Attach images (ZIP)" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                <GroupBox Header="Preview">
                    <StackPanel>
                        <ProgressBar x:Name="PreparationProgress" IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="Collapsed" />
                        <TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" MaxHeight="220" MinHeight="80"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="8" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorder}" AutomationProperties.Name="Export preview" />
                        <TextBox x:Name="FailureText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource OrangeBrush}" Padding="0" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.Name="Export error" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
