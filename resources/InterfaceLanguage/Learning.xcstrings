    "Insert the next word or the entire suggestion with your configured shortcuts." : {
      "comment" : "Read-only product guide or Home quick-link copy.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدرج الكلمة التالية أو الاقتراح كاملًا باستخدام الاختصارات التي ضبطتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge mit deinen konfigurierten Tastenkürzeln das nächste Wort oder den gesamten Vorschlag ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserta la siguiente palabra o la sugerencia completa con los atajos que hayas configurado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insérez le mot suivant ou toute la suggestion avec vos raccourcis configurés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने सेट किए गए शॉर्टकट से अगला शब्द या पूरा सुझाव डालें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisipkan kata berikutnya atau seluruh saran dengan pintasan yang telah diatur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci la parola successiva o l’intero suggerimento con le scorciatoie configurate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定したショートカットで、次の単語または候補全体を挿入します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정한 단축키로 다음 단어나 제안 전체를 삽입하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insira a próxima palavra ou toda a sugestão com os atalhos configurados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставляйте следующее слово или всю подсказку с помощью настроенных сочетаний клавиш."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarladığınız kısayollarla sonraki sözcüğü veya önerinin tamamını ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用已配置的快捷键，插入下一个词或整条补全。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用已設定的快速鍵，插入下一個詞或整條補全。"
          }
        }
      }
    },
    "Inspect the chunk alignment and look up its words" : {
      "comment" : "VoiceOver hint describing actions available on an aligned phrase.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افحص مطابقة العبارة وابحث عن كلماتها"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phrasenzuordnung prüfen und zugehörige Wörter nachschlagen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspecciona la correspondencia de frases y consulta sus palabras en el diccionario"
          }
        },
        "fr" : {
