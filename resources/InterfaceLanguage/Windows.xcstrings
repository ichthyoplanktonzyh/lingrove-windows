    "Rich dictionary display is unavailable. Check that Microsoft Edge WebView2 Runtime is installed, then reopen the dictionary.": {
      "comment": "Windows authored interface state/instruction. Template arguments preserve exact values.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rich dictionary display is unavailable. Check that Microsoft Edge WebView2 Runtime is installed, then reopen the dictionary."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词典富文本显示不可用，请确认已安装 Microsoft Edge WebView2 Runtime，然后重新打开词典。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詞典豐富文字顯示無法使用，請確認已安裝 Microsoft Edge WebView2 Runtime，然後重新開啟詞典。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書のリッチ表示を利用できません。Microsoft Edge WebView2 Runtimeを確認して辞書を開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전 서식 표시를 사용할 수 없습니다. Microsoft Edge WebView2 Runtime 설치를 확인한 후 사전을 다시 여세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’affichage enrichi est indisponible. Vérifiez Microsoft Edge WebView2 Runtime, puis rouvrez le dictionnaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die formatierte Wörterbuchansicht ist nicht verfügbar. Prüfen Sie Microsoft Edge WebView2 Runtime und öffnen Sie das Wörterbuch erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista enriquecida no está disponible. Comprueba Microsoft Edge WebView2 Runtime y vuelve a abrir el diccionario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exibição avançada está indisponível. Verifique Microsoft Edge WebView2 Runtime e reabra o dicionário."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La visualizzazione avanzata non è disponibile. Verifica Microsoft Edge WebView2 Runtime e riapri il dizionario."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расширенное отображение словаря недоступно. Проверьте Microsoft Edge WebView2 Runtime и откройте словарь заново."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العرض المنسّق غير متاح. تحقق من تثبيت Microsoft Edge WebView2 Runtime ثم أعد فتح القاموس."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शब्दकोश का समृद्ध प्रदर्शन उपलब्ध नहीं है। Microsoft Edge WebView2 Runtime जाँचें और शब्दकोश फिर खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilan kamus kaya tidak tersedia. Periksa Microsoft Edge WebView2 Runtime lalu buka ulang kamus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zengin sözlük görünümü kullanılamıyor. Microsoft Edge WebView2 Runtime kurulumunu kontrol edip sözlüğü yeniden açın."
          }
        }
      }
    },
    "Rich dictionary display is waiting for resources to close. Retry may not succeed until the application restarts.": {
      "comment": "Windows authored interface state/instruction. Template arguments preserve exact values.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rich dictionary display is waiting for resources to close. Retry may not succeed until the application restarts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词典富文本显示正在等待资源关闭，可能需要重启应用后才能重试成功。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詞典豐富文字顯示正在等待資源關閉，可能需要重新啟動應用程式後才能重試成功。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書のリッチ表示はリソースの終了を待っています。アプリの再起動まで再試行が成功しない場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전 서식 표시가 리소스 종료를 기다리는 중입니다. 앱을 다시 시작해야 재시도가 성공할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’affichage enrichi attend la fermeture des ressources. Un redémarrage de l’application peut être nécessaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die formatierte Ansicht wartet auf das Schließen von Ressourcen. Erneute Versuche können bis zum App-Neustart scheitern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista enriquecida espera al cierre de recursos. Puede ser necesario reiniciar la aplicación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exibição avançada aguarda o fechamento dos recursos. Pode ser necessário reiniciar o aplicativo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista avanzata attende la chiusura delle risorse. Potrebbe essere necessario riavviare l’app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расширенная отрисовка ждёт закрытия ресурсов. Повторная попытка может не сработать до перезапуска приложения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتظر العرض المنسّق إغلاق الموارد. قد لا تنجح إعادة المحاولة حتى إعادة تشغيل التطبيق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समृद्ध प्रदर्शन संसाधनों के बंद होने की प्रतीक्षा कर रहा है। ऐप फिर शुरू करने तक प्रयास सफल नहीं हो सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilan kaya menunggu sumber daya ditutup. Percobaan ulang mungkin gagal hingga aplikasi dimulai ulang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zengin görünüm kaynakların kapanmasını bekliyor. Uygulama yeniden başlatılana kadar yeniden deneme başarısız olabilir."
          }
        }
      }
    },
