    "Lingrove is already running. Check the system tray.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove is already running. Check the system tray."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove 已在运行，请查看系统托盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove 已在執行，請查看系統匣。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingroveは既に実行中です。システムトレイを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove가 이미 실행 중입니다. 시스템 트레이를 확인하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove est déjà en cours d’exécution. Consultez la zone de notification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove wird bereits ausgeführt. Prüfen Sie den Infobereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove ya se está ejecutando. Revisa la bandeja del sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove já está em execução. Verifique a bandeja do sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove è già in esecuzione. Controlla l’area di notifica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove уже запущен. Проверьте системный трей."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove قيد التشغيل بالفعل. تحقق من علبة النظام."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove पहले से चल रहा है। सिस्टम ट्रे देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove sudah berjalan. Periksa baki sistem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove zaten çalışıyor. Sistem tepsisini kontrol edin."
          }
        }
      }
    },
