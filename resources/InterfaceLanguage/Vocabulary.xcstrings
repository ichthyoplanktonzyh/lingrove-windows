          "stringUnit": {
            "state": "translated",
            "value": "請對應所選音訊欄位，或更新拾語範本。"
          }
        }
      }
    },
    "Map unique fields for the sense ID, expression and answer.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيّن حقولًا منفصلة لمعرّف المعنى والتعبير والإجابة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnen Sie Bedeutungs-ID, Ausdruck und Antwort jeweils ein eigenes Feld zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map unique fields for the sense ID, expression and answer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna campos distintos al ID del sentido, la expresión y la respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez des champs distincts à l’identifiant du sens, à l’expression et à la réponse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अर्थ ID, अभिव्यक्ति और उत्तर के लिए अलग-अलग फ़ील्ड मैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Petakan bidang berbeda untuk ID makna, ungkapan, dan jawaban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna campi distinti a ID del significato, espressione e risposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語義 ID、表現、解答に別々のフィールドを割り当ててください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의미 ID, 표현, 답안에 각각 고유한 필드를 매핑하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapeie campos distintos para o ID do sentido, a expressão e a resposta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сопоставьте отдельные поля с ID значения, выражением и ответом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlam kimliği, ifade ve yanıt için ayrı alanlar eşleştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请为义项 ID、表达和答案分别映射独立字段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請為義項 ID、表達和答案分別對應獨立欄位。"
